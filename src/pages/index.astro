---
import {
  ArrowRight,
  BookOpen,
  Braces,
  FilePenLine,
  Gauge,
  ShieldCheck,
  Sparkles,
} from '@lucide/astro';

import ChangeWorkflow from '../components/change-workflow/change-workflow.astro';
import CodingModesComparison from '../components/coding-modes-comparison/coding-modes-comparison.astro';
import ContextAuthority from '../components/context-authority/context-authority.astro';
import MaturityWorkflow from '../components/maturity-workflow/maturity-workflow.astro';
import PlanningDialogue from '../components/planning-dialogue/planning-dialogue.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { SITE_CONFIG } from '../site.config.ts';
---

<BaseLayout
  canonicalPath="/"
  description={SITE_CONFIG.defaultDescription}
  title="Agentic Coding — Better software with coding agents"
  structuredDataType="website"
>
  <section class="relative overflow-hidden border-b border-border py-20 sm:py-28 lg:py-36">
    <div class="page-shell relative">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-end">
        <div>
          <p class="eyebrow">A discipline for software development after manual coding</p>
          <h1 class="display-title mt-6">More leverage. Same responsibility.</h1>
          <p class="lede mt-8">
            Coding agents can help us plan, build, test, and review at extraordinary speed. Agentic
            Coding is the discipline of using that leverage without surrendering context, control,
            or quality.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              class="action-primary"
              href="/start/"
            >
              Start with the foundation
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </a>
            <a
              class="action-secondary"
              href="/refine/"
              >Refine instructions</a
            >
            <a
              class="action-secondary"
              href="/cookbook/"
              >Open the cookbook</a
            >
          </div>
        </div>
        <aside class="border-l border-border-strong pl-6">
          <div
            class="font-mono text-[clamp(3.5rem,9vw,7rem)] leading-none font-black tracking-[-0.1em] text-accent"
            aria-hidden="true"
          >
            &lt;/&gt;
          </div>
          <p class="mt-6 text-sm leading-6 text-muted">
            Software development after manual coding, without giving up engineering.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="border-b border-border py-16">
    <div class="page-shell grid gap-8 md:grid-cols-[12rem_1fr]">
      <p class="eyebrow">01 · The transition</p>
      <div class="grid gap-6 lg:grid-cols-2">
        <h2 class="text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">
          AI made code generation cheap. Engineering did not become optional.
        </h2>
        <p class="text-lg leading-8 text-muted">
          Software development was dominated by manually written implementation. Now code can arrive
          in seconds. The question is no longer whether AI can produce code. It is whether our
          process can consistently turn that capability into software worth maintaining.
        </p>
      </div>
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="modes-title"
  >
    <div class="page-shell">
      <p class="eyebrow">02 · Three operating modes</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_28rem] lg:items-end">
        <h2
          id="modes-title"
          class="section-title"
        >
          The difference is control, not line count.
        </h2>
        <p class="lede text-base sm:text-lg">
          An agent may write most of the implementation and the work can still be deeply engineered.
          What matters is who controls the decisions, scope, evidence, and quality.
        </p>
      </div>
      <CodingModesComparison />
    </div>
  </section>

  <section
    class="section-space relative overflow-hidden border-b border-border bg-primary text-primary-foreground"
  >
    <div class="page-shell">
      <p class="eyebrow !text-white/60">03 · A working definition</p>
      <blockquote
        class="mt-8 max-w-5xl text-[clamp(2rem,5.4vw,4.8rem)] leading-[1.02] font-bold tracking-[-0.045em] text-balance"
      >
        Agentic Coding is a collaborative software-development discipline in which developers use
        coding agents across planning, decomposition, implementation, verification, and review while
        retaining responsibility for intent, system direction, and engineering quality.
      </blockquote>
      <p class="mt-16 border-t border-white/25 pt-7 text-xl font-bold sm:text-3xl">
        Do not delegate engineering to the agent. Engineer with the agent.
      </p>
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="planning-title"
  >
    <div class="page-shell">
      <p class="eyebrow">04 · Collaborate on the plan</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_28rem] lg:items-end">
        <h2
          id="planning-title"
          class="section-title"
        >
          The agent is not just waiting for instructions.
        </h2>
        <p class="lede text-base sm:text-lg">
          It can inspect the system, find patterns, trace consequences, challenge an initial
          approach, and help the developer converge on a stronger strategy before either writes
          production code.
        </p>
      </div>
      <PlanningDialogue />
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-secondary/55"
    aria-labelledby="change-loop-title"
  >
    <div class="page-shell">
      <p class="eyebrow">05 · The change loop</p>
      <h2
        id="change-loop-title"
        class="section-title mt-5"
      >
        Plan → Breakdown → Execute → Review
      </h2>
      <p class="lede mt-6">
        Move from ambiguity to evidence in coherent, authorized slices. The process creates stopping
        points where assumptions can be corrected before they spread.
      </p>
      <ChangeWorkflow />
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="pave-title"
  >
    <div class="page-shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_26rem]">
      <div>
        <p class="eyebrow">06 · Pave the way</p>
        <h2
          id="pave-title"
          class="section-title mt-5"
        >
          Capability is not a substitute for a clear engineering system.
        </h2>
        <p class="lede mt-6">
          When the environment is ambiguous, the agent must solve the task while simultaneously
          inventing where code belongs, how errors work, what tests mean, and when to stop.
        </p>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-xl border border-border bg-border text-sm">
        {
          [
            'Missed details and overlooked contracts',
            'Duplicate code and weak reuse',
            'Inconsistent architecture',
            'Unnecessary adjacent work',
            'Unclear stopping points',
            'Technically plausible but misplaced solutions',
          ].map((item) => (
            <li class="flex items-center gap-3 bg-background p-4">
              <span
                class="size-2 shrink-0 rounded-full bg-chart-3"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="page-shell mt-16 border-t border-border-strong pt-8">
      <p class="max-w-5xl text-2xl leading-tight font-extrabold tracking-tight sm:text-4xl">
        Before you delegate broadly, establish the path you want the agent to follow.
      </p>
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="maturity-title"
  >
    <div class="page-shell">
      <p class="eyebrow">07 · The project maturity loop</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_28rem] lg:items-end">
        <h2
          id="maturity-title"
          class="section-title"
        >
          Demonstrate → Codify → Delegate → Verify
        </h2>
        <p class="lede text-base sm:text-lg">
          This is not the loop for one feature. It is how the relationship between developer, agent,
          and codebase becomes safer and more effective over time.
        </p>
      </div>
      <MaturityWorkflow />
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-secondary/55"
    aria-labelledby="authority-title"
  >
    <div class="page-shell">
      <p class="eyebrow">08 · Wide context, narrow authority</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_28rem] lg:items-end">
        <h2
          id="authority-title"
          class="section-title"
        >
          Give agents context. Do not give them free rein.
        </h2>
        <p class="lede text-base sm:text-lg">
          The agent should inspect enough surrounding code to understand the complete affected path.
          Understanding an adjacent dependency is not authorization to change it.
        </p>
      </div>
      <ContextAuthority />
      <p class="mt-8 text-xl font-extrabold">A dependency is not automatically a deliverable.</p>
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="leverage-title"
  >
    <div class="page-shell">
      <p class="eyebrow">09 · The lasting opportunity</p>
      <h2
        id="leverage-title"
        class="section-title mt-5"
      >
        The first benefit is speed. The lasting benefit should be better software.
      </h2>
      <div
        class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          [
            {
              icon: Sparkles,
              title: 'Explore more',
              text: 'Inspect unfamiliar systems and compare more credible alternatives.',
            },
            {
              icon: Gauge,
              title: 'Attempt more',
              text: 'Make deeper planning, tests, and documentation economically practical.',
            },
            {
              icon: Braces,
              title: 'Correct more',
              text: 'Repeat review and revision without treating the first output as final.',
            },
            {
              icon: ShieldCheck,
              title: 'Judge more',
              text: 'Spend developer attention on tradeoffs, direction, and system quality.',
            },
          ].map(({ icon: Icon, text, title }) => (
            <article class="bg-background p-6 sm:p-8">
              <Icon
                class="size-6 text-accent"
                aria-hidden="true"
              />
              <h3 class="mt-8 text-xl font-extrabold">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
            </article>
          ))
        }
      </div>
      <p class="lede mt-10">
        Manual coding skills remain essential. What changes is how much engineering work one
        developer can afford to attempt—and how much attention can move from typing toward judgment
        and system design.
      </p>
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-primary text-primary-foreground"
    aria-labelledby="reliability-title"
  >
    <div class="page-shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_25rem]">
      <div>
        <p class="eyebrow !text-white/60">10 · Capability without free rein</p>
        <h2
          id="reliability-title"
          class="section-title mt-5"
        >
          Coding agents are capable enough to build the wrong system convincingly.
        </h2>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-white/75">
          They can misunderstand intent, miss context, duplicate a mechanism, broaden scope, or
          satisfy tests without satisfying the real requirement. The answer is not weaker tools. It
          is stronger context, boundaries, transparency, tests, review, and developer control.
        </p>
      </div>
      <div class="self-end rounded-xl border border-white/25 p-6 font-mono text-sm leading-7">
        <p class="text-white/55">reliability-system.txt</p>
        <p class="mt-5">
          Context → Constraints → Plan → Breakdown → Execution → Tests → Review → Correction
        </p>
      </div>
    </div>
    <div class="page-shell mt-16 border-t border-white/25 pt-8">
      <p class="text-2xl font-extrabold sm:text-4xl">
        The agent provides capability. The engineering process provides reliability.
      </p>
    </div>
  </section>

  <section
    class="section-space"
    aria-labelledby="resources-title"
  >
    <div class="page-shell">
      <p class="eyebrow">11 · Put it into practice</p>
      <h2
        id="resources-title"
        class="section-title mt-5"
      >
        Start with a stronger operating system for the work.
      </h2>
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        <a
          class="group rounded-xl border border-border bg-surface p-6 no-underline shadow-surface sm:p-8"
          href="/start/"
        >
          <Braces
            class="size-7 text-accent"
            aria-hidden="true"
          />
          <h3 class="mt-12 text-2xl font-extrabold tracking-tight">Start with the foundation</h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Adopt a neutral, production-minded AGENTS.md in a new repository.
          </p>
          <span class="mt-8 inline-flex items-center gap-2 font-bold"
            >Open foundation <ArrowRight
              class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
              aria-hidden="true"
            /></span
          >
        </a>
        <a
          class="group rounded-xl border border-border bg-surface p-6 no-underline shadow-surface sm:p-8"
          href="/refine/"
        >
          <FilePenLine
            class="size-7 text-accent"
            aria-hidden="true"
          />
          <h3 class="mt-12 text-2xl font-extrabold tracking-tight">Refine existing instructions</h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Preserve project-specific guidance while strengthening the engineering process.
          </p>
          <span class="mt-8 inline-flex items-center gap-2 font-bold"
            >Open prompt <ArrowRight
              class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
              aria-hidden="true"
            /></span
          >
        </a>
        <a
          class="group rounded-xl border border-border bg-surface p-6 no-underline shadow-surface sm:p-8"
          href="/cookbook/"
        >
          <BookOpen
            class="size-7 text-accent"
            aria-hidden="true"
          />
          <h3 class="mt-12 text-2xl font-extrabold tracking-tight">Practice the workflow</h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Use concrete techniques for planning, execution, review, and correction.
          </p>
          <span class="mt-8 inline-flex items-center gap-2 font-bold"
            >Open cookbook <ArrowRight
              class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
              aria-hidden="true"
            /></span
          >
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
