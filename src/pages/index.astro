---
import { ArrowRight, Braces, Gauge, ShieldCheck, Sparkles } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import Section from 'jg-personal-astro-ui/section';

import CodingAgentStrip from '../components/coding-agent-strip/coding-agent-strip.astro';
import CodingModesComparison from '../components/coding-modes-comparison/coding-modes-comparison.astro';
import ContextAuthority from '../components/context-authority/context-authority.astro';
import EngineeringContract from '../components/engineering-contract/engineering-contract.astro';
import HeroSession from '../components/hero-session/hero-session.astro';
import MaturitySystem from '../components/maturity-system/maturity-system.astro';
import MoldeaProof from '../components/moldea-proof/moldea-proof.astro';
import ResourceActions from '../components/resource-actions/resource-actions.astro';
import SkillPipeline from '../components/skill-pipeline/skill-pipeline.astro';
import SkillsBridge from '../components/skills-bridge/skills-bridge.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { SITE_CONFIG } from '../site.config.ts';

const leverageItems = [
  {
    icon: Sparkles,
    text: 'Inspect unfamiliar systems and compare more credible alternatives.',
    title: 'Explore more',
  },
  {
    icon: Gauge,
    text: 'Make deeper planning, tests, and documentation economically practical.',
    title: 'Attempt more',
  },
  {
    icon: Braces,
    text: 'Repeat agent review and harden the evidence without treating the first output as final.',
    title: 'Correct more',
  },
  {
    icon: ShieldCheck,
    text: 'Spend developer attention on tradeoffs, direction, and system quality.',
    title: 'Judge more',
  },
] as const;
---

<BaseLayout
  canonicalPath="/"
  description={SITE_CONFIG.defaultDescription}
  title="Agentic Coding | Better software with coding agents"
  structuredDataType="website"
>
  <section class="border-b border-border pt-14 pb-16 sm:pt-20 sm:pb-20">
    <div
      class="jg-container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-14"
    >
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow">Professional software development after manual coding</p>
        <h1 class="display-title mt-6">
          A disciplined way to build software{' '}
          <span class="block text-accent">with coding agents.</span>
        </h1>
        <p class="lede mt-7">
          <code class="text-[0.9em] text-foreground">AGENTS.md</code> sets the standards. Skills run the
          workflow. You decide how much to delegate, while the agent carries the evidence.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/start/">
            Start with the foundation
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </Button>
          <Button
            href="/workflow/"
            variant="outline"
          >
            See the workflow
          </Button>
        </div>
      </div>
      <HeroSession />
    </div>
  </section>

  <Section
    id="operating-model"
    align="center"
    eyebrow="01 / The operating model"
    lede="An agent may write most of the code and the work can still be deeply engineered. What matters is who controls the decisions, scope, evidence, and quality."
    title="The difference is control, not line count."
  >
    <div class="mt-12 grid gap-6 border-y border-border py-7 lg:grid-cols-2 lg:items-center">
      <h3 class="text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
        AI made code generation cheap. Engineering did not become optional.
      </h3>
      <p class="text-base leading-7 text-muted">
        Code can arrive in seconds. The real question is whether the process can consistently turn
        that capability into software worth maintaining.
      </p>
    </div>

    <CodingModesComparison />

    <div
      class="mt-12 grid gap-8 rounded-xl border border-border bg-secondary/45 p-6 sm:p-8 lg:grid-cols-[1.1fr_0.9fr]"
    >
      <div>
        <p class="eyebrow">A working definition</p>
        <p class="mt-4 text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
          A collaborative discipline, not a shortcut.
        </p>
        <p class="mt-5 text-base leading-7 text-muted">
          Agents work across the lifecycle. Developers keep intent, direction, and quality.
        </p>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-lg border border-border bg-border">
        <div class="bg-background p-4">
          <dt class="font-mono text-xs font-bold text-accent uppercase">Across the lifecycle</dt>
          <dd class="mt-2 text-sm leading-6 text-muted">
            Plan, challenge, implement, verify, and correct.
          </dd>
        </div>
        <div class="bg-background p-4">
          <dt class="font-mono text-xs font-bold text-accent uppercase">Under direction</dt>
          <dd class="mt-2 text-sm leading-6 text-muted">The developer owns goals and tradeoffs.</dd>
        </div>
        <div class="bg-background p-4">
          <dt class="font-mono text-xs font-bold text-accent uppercase">Closed by evidence</dt>
          <dd class="mt-2 text-sm leading-6 text-muted">
            Independent tests, agent review, and developer judgment earn confidence.
          </dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section
    id="engineering-contract"
    align="center"
    eyebrow="02 / Engineer the contract"
    title="Reliable delegation has layers."
  >
    <p
      slot="header-end"
      class="lede mx-auto mt-5"
    >
      <code class="text-[0.9em] text-foreground">AGENTS.md</code> turns authority, evidence, ownership,
      coherence, judgment, and publication into one contract every skill works within.
    </p>
    <EngineeringContract />
  </Section>

  <Section
    id="collaboration"
    align="center"
    class="bg-secondary/35"
    eyebrow="03 / Run the workflow"
    lede="Each step runs only when you invoke its skill. The agent plans, builds, and assembles the evidence; you approve the plan, choose the outcome, and grant publication."
    title="Plan together. Build in slices. Publish on your terms."
  >
    <SkillPipeline />
  </Section>

  <Section
    id="maturity"
    align="center"
    eyebrow="04 / Mature the project"
    lede="Demonstrate the path, codify what repeats, and delegate more as the evidence earns it, up to autonomous runs with explicit limits."
    title="Clear systems earn wider delegation."
  >
    <MaturitySystem />
  </Section>

  <Section
    id="authority"
    align="center"
    class="bg-secondary/35"
    eyebrow="05 / Bound the authority"
    lede="Inspect enough surrounding code to understand the complete affected path. Change only what the approved task requires, then use evidence to decide whether the result is acceptable."
    title="Wide context. Narrow authority."
  >
    <ContextAuthority />
  </Section>

  <Section
    id="leverage"
    align="center"
    eyebrow="06 / Use the leverage"
    lede="Manual coding skills remain essential. Agentic Coding moves more developer attention from typing and routine inspection toward judgment, system design, independent test oracles, and correction."
    title="The first benefit is speed. The lasting benefit should be better software."
  >
    <div
      class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        leverageItems.map(({ icon: Icon, text, title }) => (
          <article class="bg-background p-6">
            <Icon
              class="size-5 text-accent"
              aria-hidden="true"
            />
            <h3 class="mt-10 text-lg font-semibold tracking-tight">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
          </article>
        ))
      }
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-center text-xl leading-8 font-semibold">
      The agent provides capability. The engineering process provides reliability.
    </p>
  </Section>

  <Section
    id="moldea-proof"
    align="center"
    class="bg-secondary/35"
    eyebrow="07 / Applied in practice"
    lede="Agentic Coding was shaped while building moldea, where project context, agent instructions, deterministic validation, adversarial tests, agent evidence, and developer judgment have to operate as one coherent system."
    title="Built through real project work."
  >
    <MoldeaProof />
  </Section>

  <Section
    id="resources"
    align="center"
    eyebrow="08 / Put it into practice"
    lede="Set the standards, install the skills, refine what the repository already knows, and keep techniques at hand for the harder moments."
    title="Give the work a stronger operating system."
  >
    <ResourceActions />
  </Section>

  <SkillsBridge />

  <CodingAgentStrip />
</BaseLayout>
