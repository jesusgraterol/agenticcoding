---
import { ArrowRight, Braces, Gauge, ShieldCheck, Sparkles } from '@lucide/astro';

import CodingAgentStrip from '../components/coding-agent-strip/coding-agent-strip.astro';
import CodingModesComparison from '../components/coding-modes-comparison/coding-modes-comparison.astro';
import CollaborationWorkbench from '../components/collaboration-workbench/collaboration-workbench.astro';
import ContextAuthority from '../components/context-authority/context-authority.astro';
import HeroWorkbench from '../components/hero-workbench/hero-workbench.astro';
import MaturitySystem from '../components/maturity-system/maturity-system.astro';
import MoldeaProof from '../components/moldea-proof/moldea-proof.astro';
import ResourceActions from '../components/resource-actions/resource-actions.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { SITE_CONFIG } from '../site.config.ts';

const leverageItems = [
  {
    icon: Sparkles,
    text: 'Inspect unfamiliar systems and compare more credible alternatives.',
    title: 'Explore more',
  },
  {
    icon: Gauge,
    text: 'Make deeper planning, tests, and documentation economically practical.',
    title: 'Attempt more',
  },
  {
    icon: Braces,
    text: 'Repeat review and revision without treating the first output as final.',
    title: 'Correct more',
  },
  {
    icon: ShieldCheck,
    text: 'Spend developer attention on tradeoffs, direction, and system quality.',
    title: 'Judge more',
  },
] as const;
---

<BaseLayout
  canonicalPath="/"
  description={SITE_CONFIG.defaultDescription}
  title="Agentic Coding | Better software with coding agents"
  structuredDataType="website"
>
  <section class="border-b border-border pt-20 pb-16 sm:pt-28 sm:pb-20">
    <div class="page-shell">
      <div class="mx-auto max-w-4xl text-center">
        <p class="eyebrow">Professional software development after manual coding</p>
        <h1 class="display-title mx-auto mt-6">
          A disciplined way to build software
          <span class="block text-accent">with coding agents.</span>
        </h1>
        <p class="lede mx-auto mt-7">
          Use coding agents across planning, implementation, verification, and review while keeping
          intent, direction, and quality in the developer's hands.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            class="action-primary"
            href="/start/"
          >
            Start with the foundation
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </a>
          <a
            class="action-secondary"
            href="/cookbook/"
            >See the workflow</a
          >
        </div>
      </div>
      <HeroWorkbench />
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="operating-model-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">01 / The operating model</p>
        <h2
          id="operating-model-title"
          class="section-title mx-auto mt-4"
        >
          The difference is control, not line count.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          An agent may write most of the implementation and the work can still be deeply engineered.
          What matters is who controls the decisions, scope, evidence, and quality.
        </p>
      </div>

      <div class="mt-12 grid gap-6 border-y border-border py-7 lg:grid-cols-2 lg:items-center">
        <h3 class="text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
          AI made code generation cheap. Engineering did not become optional.
        </h3>
        <p class="text-base leading-7 text-muted">
          Code can arrive in seconds. The real question is whether the process can consistently turn
          that capability into software worth maintaining.
        </p>
      </div>

      <CodingModesComparison />

      <div
        class="mt-12 grid gap-8 rounded-xl border border-border bg-secondary/45 p-6 sm:p-8 lg:grid-cols-[1.1fr_0.9fr]"
      >
        <div>
          <p class="eyebrow">A working definition</p>
          <p class="mt-4 text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
            A collaborative discipline, not a shortcut.
          </p>
          <p class="mt-5 text-base leading-7 text-muted">
            Developers use coding agents throughout the work while retaining responsibility for
            intent, system direction, and engineering quality.
          </p>
        </div>
        <dl class="grid gap-px overflow-hidden rounded-lg border border-border bg-border">
          <div class="bg-background p-4">
            <dt class="font-mono text-xs font-bold text-accent uppercase">Across the lifecycle</dt>
            <dd class="mt-2 text-sm leading-6 text-muted">Plan, implement, verify, and correct.</dd>
          </div>
          <div class="bg-background p-4">
            <dt class="font-mono text-xs font-bold text-accent uppercase">Under direction</dt>
            <dd class="mt-2 text-sm leading-6 text-muted">
              The developer owns goals and tradeoffs.
            </dd>
          </div>
          <div class="bg-background p-4">
            <dt class="font-mono text-xs font-bold text-accent uppercase">Closed by evidence</dt>
            <dd class="mt-2 text-sm leading-6 text-muted">Tests and review earn confidence.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-secondary/35"
    aria-labelledby="collaboration-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">02 / Collaborate on the work</p>
        <h2
          id="collaboration-title"
          class="section-title mx-auto mt-4"
        >
          Plan together. Execute in bounded slices.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          The agent can inspect the system, challenge an approach, and help converge on a stronger
          strategy before production code is written.
        </p>
      </div>
      <CollaborationWorkbench />
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="maturity-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">03 / Mature the project</p>
        <h2
          id="maturity-title"
          class="section-title mx-auto mt-4"
        >
          Clear systems earn wider delegation.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          Demonstrate the path, codify what repeats, delegate as the environment becomes dependable,
          and keep verification as the corrective layer.
        </p>
      </div>
      <MaturitySystem />
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-secondary/35"
    aria-labelledby="authority-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">04 / Bound the authority</p>
        <h2
          id="authority-title"
          class="section-title mx-auto mt-4"
        >
          Wide context. Narrow authority.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          Inspect enough surrounding code to understand the complete affected path. Change only what
          the approved task requires, then use evidence to decide whether the result is acceptable.
        </p>
      </div>
      <ContextAuthority />
    </div>
  </section>

  <section
    class="section-space border-b border-border"
    aria-labelledby="leverage-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">05 / Use the leverage</p>
        <h2
          id="leverage-title"
          class="section-title section-title-long mx-auto mt-4"
        >
          The first benefit is speed. The lasting benefit should be better software.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          Manual coding skills remain essential. Agentic Coding moves more developer attention from
          typing toward judgment, system design, and correction.
        </p>
      </div>
      <div
        class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          leverageItems.map(({ icon: Icon, text, title }) => (
            <article class="bg-background p-6">
              <Icon
                class="size-5 text-accent"
                aria-hidden="true"
              />
              <h3 class="mt-10 text-lg font-semibold tracking-tight">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
            </article>
          ))
        }
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center text-xl leading-8 font-semibold">
        The agent provides capability. The engineering process provides reliability.
      </p>
    </div>
  </section>

  <section
    class="section-space border-b border-border bg-secondary/35"
    aria-labelledby="moldea-proof-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">06 / Applied in practice</p>
        <h2
          id="moldea-proof-title"
          class="section-title mx-auto mt-4"
        >
          Built through real project work.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          Agentic Coding was shaped while building moldea, where project context, agent
          instructions, deterministic validation, and review have to operate as one coherent system.
        </p>
      </div>
      <MoldeaProof />
    </div>
  </section>

  <section
    class="section-space"
    aria-labelledby="resources-title"
  >
    <div class="page-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">07 / Put it into practice</p>
        <h2
          id="resources-title"
          class="section-title mx-auto mt-4"
        >
          Give the work a stronger operating system.
        </h2>
        <p class="lede mx-auto mt-6 text-base sm:text-lg">
          Establish the foundation, refine what the repository already knows, and practice the
          workflow through concrete conversations.
        </p>
      </div>
      <ResourceActions />
    </div>
  </section>

  <CodingAgentStrip />
</BaseLayout>
