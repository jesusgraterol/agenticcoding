---
import LinkCard from 'jg-personal-astro-ui/link-card';
import TextLink from 'jg-personal-astro-ui/text-link';

import ContentLayout from '../../layouts/content-layout.astro';
import type { ICookbookCategory } from '../../content/index.ts';
import {
  calculateReadingTime,
  COOKBOOK_TRACKS,
  loadPublishedRecipes,
} from '../../utilities/cookbook/index.ts';

const recipes = await loadPublishedRecipes();

const startingPoints = [
  {
    description: 'Build a working map before choosing where a change belongs.',
    href: '/cookbook/orient-to-a-codebase/',
    label: 'The codebase is new to me',
  },
  {
    description: 'Turn an outcome into one grounded, approval-ready plan with jg-plan.',
    href: '/workflow/#jg-plan',
    label: 'I need a plan',
  },
  {
    description: 'Reproduce it, find the cause, and fix it with a test that fails first.',
    href: '/workflow/#jg-debug',
    label: 'Something is broken',
  },
  {
    description: 'Audit the current state and recover without discarding useful work.',
    href: '/cookbook/recover-from-agent-drift/',
    label: 'The agent has drifted',
  },
] as const;

const tracks = (Object.keys(COOKBOOK_TRACKS) as ICookbookCategory[]).map((category) => ({
  ...COOKBOOK_TRACKS[category],
  category,
}));
---

<ContentLayout
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Cookbook', path: '/cookbook/' },
  ]}
  canonicalPath="/cookbook/"
  description="Techniques for the situations no workflow skill runs: orienting, controlling scope, keeping documentation current, recovering from drift, deepening tests, and refining instructions."
  eyebrow="Agentic Coding cookbook"
  structuredDataType="collection"
  title="Choose the conversation your work needs."
>
  <section class="jg-section-space">
    <div class="jg-container">
      <div class="grid gap-8 border-b border-border pb-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="eyebrow">Start from the state you are in</p>
          <p
            class="mt-4 text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl"
          >
            A strong prompt names the engineering situation, the evidence required, and the point
            where the agent must stop.
          </p>
          <p class="mt-5 leading-7 text-muted">
            These recipes are working conversations, not incantations. Each one opens with an
            example, then gives the prompt and the follow-up moves for when the first answer is not
            good enough. Planning, building, reviewing, and publishing run through skills on the <TextLink
              class="text-foreground"
              href="/workflow/"
              >workflow page</TextLink
            >.
          </p>
        </div>

        <nav aria-labelledby="starting-points-title">
          <h2
            id="starting-points-title"
            class="text-sm font-bold"
          >
            What is happening right now?
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              startingPoints.map((startingPoint) => (
                <li>
                  <LinkCard
                    href={startingPoint.href}
                    title={startingPoint.label}
                  >
                    {startingPoint.description}
                  </LinkCard>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="mt-16 space-y-16">
        {
          tracks.map((track) => {
            const trackRecipes = recipes.filter(({ data }) => data.category === track.category);

            return (
              <section aria-labelledby={`${track.category}-title`}>
                <div class="mb-6 grid gap-2 sm:grid-cols-[minmax(0,0.65fr)_minmax(0,1fr)] sm:items-end sm:gap-8">
                  <h2
                    id={`${track.category}-title`}
                    class="text-2xl font-semibold tracking-tight sm:text-3xl"
                  >
                    {track.label}
                  </h2>
                  <p class="max-w-2xl text-sm leading-6 text-muted sm:justify-self-end sm:text-right">
                    {track.description}
                  </p>
                </div>

                <ol class="grid gap-3 md:grid-cols-2">
                  {trackRecipes.map(({ body, data }) => (
                    <li>
                      <LinkCard
                        href={`/cookbook/${data.slug}/`}
                        title={data.title}
                      >
                        <span
                          slot="kicker"
                          class="mb-1 block font-mono text-xs font-bold text-muted"
                        >
                          {String(data.order).padStart(2, '0')}
                        </span>
                        {data.description}
                        <span
                          slot="footer"
                          class="font-mono text-xs font-bold text-muted uppercase"
                        >
                          {calculateReadingTime(body ?? '')} min read
                        </span>
                      </LinkCard>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })
        }
      </div>
    </div>
  </section>
</ContentLayout>
