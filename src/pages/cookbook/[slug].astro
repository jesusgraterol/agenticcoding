---
import { render, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import CopyButton from 'jg-personal-astro-ui/copy-button';
import LinkCard from 'jg-personal-astro-ui/link-card';
import Prose from 'jg-personal-astro-ui/prose';

import SessionTranscript from '../../components/session-transcript/session-transcript.astro';
import ContentLayout from '../../layouts/content-layout.astro';
import {
  calculateReadingTime,
  COOKBOOK_TRACKS,
  loadPublishedRecipes,
} from '../../utilities/cookbook/index.ts';
import { formatIsoDate } from '../../utilities/seo/index.ts';

interface Props {
  recipe: CollectionEntry<'cookbook'>;
}

export const getStaticPaths = async () => {
  const recipes = await loadPublishedRecipes();

  return recipes.map((recipe) => ({
    params: { slug: recipe.data.slug },
    props: { recipe },
  }));
};

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const recipes = await loadPublishedRecipes();
const relatedRecipes = recipe.data.relatedSlugs.flatMap((relatedSlug) => {
  const relatedRecipe = recipes.find(({ data }) => data.slug === relatedSlug);

  return relatedRecipe ? [relatedRecipe] : [];
});
const promptSourceId = `${recipe.data.slug}-prompt`;
const trackLabel = COOKBOOK_TRACKS[recipe.data.category].label;
// only prompts with [bracketed] placeholders need the fill-in hint
const hasPromptPlaceholders = /\[[^\]]+\]/u.test(recipe.data.prompt);
const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const formattedPublishedAt = dateFormatter.format(recipe.data.publishedAt);
const formattedUpdatedAt = dateFormatter.format(recipe.data.updatedAt);
const publishedDate = formatIsoDate(recipe.data.publishedAt);
const updatedDate = formatIsoDate(recipe.data.updatedAt);
const hasBeenUpdated = recipe.data.updatedAt.getTime() !== recipe.data.publishedAt.getTime();
---

<ContentLayout
  articleSection={`Cookbook: ${trackLabel}`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Cookbook', path: '/cookbook/' },
    { name: recipe.data.title, path: `/cookbook/${recipe.data.slug}/` },
  ]}
  canonicalPath={`/cookbook/${recipe.data.slug}/`}
  description={recipe.data.description}
  eyebrow={`Cookbook · ${trackLabel}`}
  publishedAt={recipe.data.publishedAt}
  structuredDataType="article"
  title={recipe.data.title}
  titleVariant="document"
  updatedAt={recipe.data.updatedAt}
>
  <div
    slot="metadata"
    class="flex w-full flex-wrap justify-center gap-x-6 gap-y-2 font-mono text-xs font-bold text-muted"
  >
    <span>{calculateReadingTime(recipe.body ?? '')} min read</span>
    <span>
      Published <time datetime={publishedDate}>{formattedPublishedAt}</time>
    </span>
    {
      hasBeenUpdated && (
        <span>
          Updated <time datetime={updatedDate}>{formattedUpdatedAt}</time>
        </span>
      )
    }
  </div>

  <article class="py-12 sm:py-16">
    <div class="jg-container-prose">
      <p class="text-lg leading-8 text-balance">{recipe.data.situation}</p>

      <section
        class="mt-10 mb-12"
        aria-labelledby="recipe-example-title"
      >
        <h2
          id="recipe-example-title"
          class="eyebrow"
        >
          Example
        </h2>
        <div class="mt-5">
          <SessionTranscript
            label={`Example conversation: ${recipe.data.title}`}
            messages={recipe.data.example}
          />
        </div>
      </section>

      <section
        class="mb-12 overflow-hidden rounded-xl border border-border bg-surface"
        aria-labelledby="working-prompt-title"
      >
        <header
          class="flex flex-wrap items-center justify-between gap-3 border-b border-border bg-secondary/45 px-4 py-3 sm:px-5"
        >
          <h2
            id="working-prompt-title"
            class="font-bold"
          >
            Working prompt
          </h2>
          <CopyButton
            context="prompt"
            size="md"
            sourceId={promptSourceId}
            tone="outline"
          />
        </header>
        <pre
          id={promptSourceId}
          class="overflow-auto p-5 text-sm leading-6 whitespace-pre-wrap"
          tabindex="0"><code>{recipe.data.prompt}</code></pre>
        <p class="border-t border-border px-4 py-3 text-sm leading-6 text-muted sm:px-5">
          {hasPromptPlaceholders && 'Replace the bracketed context. '}Keep the repository available
          for inspection, and treat the first answer as the start of the conversation.
        </p>
      </section>

      <Prose>
        <Content />
      </Prose>

      {
        relatedRecipes.length > 0 && (
          <aside
            class="mt-16 border-t border-border pt-8"
            aria-labelledby="related-recipes-title"
          >
            <h2
              id="related-recipes-title"
              class="text-2xl font-semibold tracking-tight"
            >
              Related recipes
            </h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {relatedRecipes.map(({ data }) => (
                <LinkCard
                  href={`/cookbook/${data.slug}/`}
                  title={data.title}
                >
                  {data.description}
                </LinkCard>
              ))}
            </div>
          </aside>
        )
      }

      <Button
        class="mt-12"
        href="/cookbook/"
        variant="link"
      >
        <ArrowLeft
          class="size-4"
          aria-hidden="true"
        />
        Back to the cookbook
      </Button>
    </div>
  </article>
</ContentLayout>
