---
import { ArrowLeft } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';

import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout
  canonicalPath="/404.html"
  description="The requested Agentic Coding page could not be found."
  title="Page not found | Agentic Coding"
  noIndex
>
  <section class="jg-section-space">
    <div class="jg-container-prose">
      <p class="eyebrow">404 · Path not found</p>
      <h1 class="display-title mt-6">This path is outside the plan.</h1>
      <p class="lede mt-8">
        The link may be incomplete or out of date. Return to the homepage or open one of the
        practical resources from the navigation.
      </p>
      <Button
        class="mt-9"
        href="/"
      >
        <ArrowLeft
          class="size-4"
          aria-hidden="true"
        />
        Return home
      </Button>
    </div>
  </section>
</BaseLayout>
