---
import Callout from 'jg-personal-astro-ui/callout';
import TextLink from 'jg-personal-astro-ui/text-link';

import CodingAgentStrip from '../components/coding-agent-strip/coding-agent-strip.astro';
import ResourceDocument from '../components/resource-document/resource-document.astro';
import ContentLayout from '../layouts/content-layout.astro';
import { RESOURCE_CONFIG, RESOURCE_IDS } from '../site.config.ts';
import { loadResource } from '../utilities/resource-text/index.ts';

const resourceId = RESOURCE_IDS.RefinementPrompt;
const { text } = await loadResource(resourceId);
const resourceConfig = RESOURCE_CONFIG[resourceId];
const publishedAt = new Date(`${resourceConfig.publishedAt}T00:00:00.000Z`);
const updatedAt = new Date(`${resourceConfig.updatedAt}T00:00:00.000Z`);
const hasBeenUpdated = publishedAt.getTime() !== updatedAt.getTime();
---

<ContentLayout
  alternateDocument={{
    href: resourceConfig.rawPath,
    mediaType: 'text/plain',
    title: resourceConfig.fileName,
  }}
  articleSection="Coding instructions"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Refine', path: '/refine/' },
  ]}
  canonicalPath="/refine/"
  description="One canonical prompt for strengthening existing coding-agent instructions without erasing useful project guidance."
  eyebrow="Refine existing instructions"
  publishedAt={publishedAt}
  structuredDataType="article"
  title="Preserve what the repository already knows."
  updatedAt={updatedAt}
>
  <div
    slot="metadata"
    class="flex w-full flex-wrap justify-center gap-x-6 gap-y-2 font-mono text-xs font-bold text-muted"
  >
    <span>Version {resourceConfig.version}</span>
    <span>
      Published <time datetime={resourceConfig.publishedAt}>{resourceConfig.publishedAt}</time>
    </span>
    {
      hasBeenUpdated && (
        <span>
          Updated <time datetime={resourceConfig.updatedAt}>{resourceConfig.updatedAt}</time>
        </span>
      )
    }
  </div>

  <section class="py-12 sm:py-16">
    <div class="jg-container-prose">
      <div class="mb-10 grid gap-5 rounded-xl border border-border bg-secondary/35 p-5 sm:p-7">
        <p class="text-lg leading-8">
          Paste this prompt into the coding agent already working inside your repository. The agent
          inspects your instruction hierarchy, asks only material questions, and proposes a
          preservation-first change set.
        </p>
        <p class="text-sm leading-6 text-muted">
          This is one canonical prompt, not a builder. Your repository and your conversation supply
          the context. Repositories without useful instructions should begin with the <TextLink
            class="text-foreground"
            href="/start/"
            >ready-to-use foundation</TextLink
          >.
        </p>
        <Callout
          role="note"
          variant="warning"
        >
          <p>
            <strong>Keep the approval boundary.</strong> Review the proposed changes before authorizing
            edits to repository instructions.
          </p>
        </Callout>
      </div>
      <ResourceDocument
        copyContext="refinement prompt"
        fileName={resourceConfig.fileName}
        rawPath={resourceConfig.rawPath}
        sourceId="refinement-prompt-source"
        text={text}
      />
    </div>
  </section>
  <CodingAgentStrip />
</ContentLayout>
