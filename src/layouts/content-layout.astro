---
import PageHeader from 'jg-personal-astro-ui/page-header';

import type {
  IAlternateDocument,
  IBreadcrumbItem,
  IStructuredDataType,
} from '../utilities/seo/index.ts';

import BaseLayout from './base-layout.astro';

interface Props {
  alternateDocument?: IAlternateDocument | undefined;
  articleSection?: string | undefined;
  breadcrumbs: readonly IBreadcrumbItem[];
  canonicalPath: string;
  description: string;
  eyebrow: string;
  publishedAt?: Date | undefined;
  structuredDataType: Exclude<IStructuredDataType, 'website'>;
  title: string;
  titleVariant?: 'page' | 'document' | undefined;
  updatedAt?: Date | undefined;
}

const {
  alternateDocument,
  articleSection,
  breadcrumbs,
  canonicalPath,
  description,
  eyebrow,
  publishedAt,
  structuredDataType,
  title,
  titleVariant,
  updatedAt,
} = Astro.props;
---

<BaseLayout
  alternateDocument={alternateDocument}
  articleSection={articleSection}
  breadcrumbs={breadcrumbs}
  canonicalPath={canonicalPath}
  description={description}
  publishedAt={publishedAt}
  title={`${title} | Agentic Coding`}
  structuredDataTitle={title}
  structuredDataType={structuredDataType}
  updatedAt={updatedAt}
>
  <PageHeader
    align="center"
    breadcrumbs={breadcrumbs.map(({ name, path }) => ({ href: path, name }))}
    eyebrow={eyebrow}
    lede={description}
    title={title}
    titleVariant={titleVariant}
  >
    <Fragment slot="metadata">
      <slot name="metadata" />
    </Fragment>
  </PageHeader>
  <slot />
</BaseLayout>
