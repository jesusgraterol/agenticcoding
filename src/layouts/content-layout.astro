---
import type { IAlternateDocument, IStructuredDataType } from '../utilities/seo/index.ts';

import BaseLayout from './base-layout.astro';

interface Props {
  alternateDocument?: IAlternateDocument | undefined;
  articleSection?: string | undefined;
  canonicalPath: string;
  description: string;
  eyebrow: string;
  structuredDataType: Exclude<IStructuredDataType, 'website'>;
  title: string;
  updatedAt?: Date | undefined;
}

const {
  alternateDocument,
  articleSection,
  canonicalPath,
  description,
  eyebrow,
  structuredDataType,
  title,
  updatedAt,
} = Astro.props;
---

<BaseLayout
  alternateDocument={alternateDocument}
  articleSection={articleSection}
  canonicalPath={canonicalPath}
  description={description}
  title={`${title} | Agentic Coding`}
  structuredDataTitle={title}
  structuredDataType={structuredDataType}
  updatedAt={updatedAt}
>
  <header class="border-b border-border py-16 sm:py-20">
    <div class="prose-shell text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h1
        class="mx-auto mt-4 max-w-4xl text-[clamp(2.75rem,6vw,4rem)] leading-[1.02] font-semibold tracking-[-0.045em] text-balance"
      >
        {title}
      </h1>
      <p class="lede mx-auto mt-6">{description}</p>
      <slot name="metadata" />
    </div>
  </header>
  <slot />
</BaseLayout>
