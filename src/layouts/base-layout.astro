---
import { GitBranch } from '@lucide/astro';
import AgenticCodingMark from 'jg-personal-astro-ui/agentic-coding-mark';
import BrandLogo from 'jg-personal-astro-ui/brand-logo';
import Button from 'jg-personal-astro-ui/button';
import DocumentHead from 'jg-personal-astro-ui/document-head';
import NavigationProgress from 'jg-personal-astro-ui/navigation-progress';
import SiteFooter from 'jg-personal-astro-ui/site-footer';
import SiteHeader from 'jg-personal-astro-ui/site-header';
import SkipLink from 'jg-personal-astro-ui/skip-link';
import TextLink from 'jg-personal-astro-ui/text-link';
import ThemeControl from 'jg-personal-astro-ui/theme-control';
import ThemeInitScript from 'jg-personal-astro-ui/theme-init-script';

import { SITE_CONFIG } from '../site.config.ts';
import {
  buildStructuredData,
  formatIsoDate,
  type IAlternateDocument,
  type IBreadcrumbItem,
  type IStructuredDataType,
} from '../utilities/seo/index.ts';
import '../styles/global.css';

interface Props {
  alternateDocument?: IAlternateDocument | undefined;
  articleSection?: string | undefined;
  breadcrumbs?: readonly IBreadcrumbItem[] | undefined;
  canonicalPath: string;
  description: string;
  title: string;
  noIndex?: boolean | undefined;
  publishedAt?: Date | undefined;
  structuredDataTitle?: string | undefined;
  structuredDataType?: IStructuredDataType | undefined;
  updatedAt?: Date | undefined;
}

const {
  alternateDocument,
  articleSection,
  breadcrumbs,
  canonicalPath,
  description,
  noIndex = false,
  publishedAt,
  structuredDataType,
  title,
  structuredDataTitle = title,
  updatedAt,
} = Astro.props;
const toSiteUrl = (path: string): string => new URL(path, SITE_CONFIG.url).toString();
const canonicalUrl = toSiteUrl(canonicalPath);
const isArticle = structuredDataType === 'article';
const structuredData = structuredDataType
  ? buildStructuredData({
      articleSection,
      breadcrumbs,
      canonicalUrl,
      description,
      publishedAt,
      title: structuredDataTitle,
      type: structuredDataType,
      updatedAt,
    })
  : undefined;
const { openGraph } = SITE_CONFIG;
// the site's pages after the home page, with the cookbook current on its recipes too, and the
// skills site, which opens in a new tab
const navigationItems = [
  ...SITE_CONFIG.navigation
    .slice(1)
    .map((item) => (item.href === '/cookbook/' ? { ...item, match: 'prefix' as const } : item)),
  { external: true, href: SITE_CONFIG.skills.url, label: 'Skills' },
];
const footerColumns = [
  { title: 'Resources', links: SITE_CONFIG.navigation.slice(1) },
  {
    title: 'Project',
    links: [
      { external: true, href: SITE_CONFIG.repositoryUrl, label: 'Source repository' },
      { external: true, href: SITE_CONFIG.skills.url, label: SITE_CONFIG.skills.name },
      { href: '/llms.txt', label: 'llms.txt' },
    ],
  },
];
---

<!doctype html>
<html lang={SITE_CONFIG.language}>
  <head>
    <DocumentHead
      alternate={alternateDocument === undefined
        ? undefined
        : {
            href: toSiteUrl(alternateDocument.href),
            title: alternateDocument.title,
            type: alternateDocument.mediaType,
          }}
      article={isArticle
        ? {
            author: SITE_CONFIG.author.url,
            modifiedTime: updatedAt ? formatIsoDate(updatedAt) : undefined,
            publishedTime: publishedAt ? formatIsoDate(publishedAt) : undefined,
            section: articleSection,
          }
        : undefined}
      author={SITE_CONFIG.author.name}
      canonicalUrl={canonicalUrl}
      description={description}
      icons={[{ href: '/favicon.svg', rel: 'icon', type: 'image/svg+xml' }]}
      llmsTextUrl={toSiteUrl('/llms.txt')}
      locale={openGraph.locale}
      noIndex={noIndex}
      openGraphImage={{
        alt: openGraph.imageAlt,
        height: openGraph.height,
        type: openGraph.imageType,
        url: toSiteUrl(openGraph.image),
        width: openGraph.width,
      }}
      openGraphType={isArticle ? 'article' : 'website'}
      siteName={SITE_CONFIG.name}
      structuredData={structuredData}
      themeColors={SITE_CONFIG.themeColors}
      title={title}
    />
    <ThemeInitScript
      storageKey={SITE_CONFIG.storageKeys.theme}
      themeColors={SITE_CONFIG.themeColors}
    />
  </head>
  <body>
    <SkipLink />
    <NavigationProgress />
    <SiteHeader
      currentPath={Astro.url.pathname}
      homeLabel={`${SITE_CONFIG.name} home`}
      items={navigationItems}
    >
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
      >
        <AgenticCodingMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="icon"
          variant="ghost"
          title="Source repository"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          <span class="sr-only">Source repository</span>
        </Button>
        <ThemeControl storageKey={SITE_CONFIG.storageKeys.theme} />
      </Fragment>
      <Fragment slot="mobile-actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="sm"
          variant="outline"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          Source
        </Button>
        <ThemeControl
          class="ml-auto"
          storageKey={SITE_CONFIG.storageKeys.theme}
        />
      </Fragment>
    </SiteHeader>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter
      columns={footerColumns}
      notes={[SITE_CONFIG.url.replace('https://', ''), `${SITE_CONFIG.license} License, © 2026`]}
    >
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
      >
        <AgenticCodingMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="about">
        Built by <TextLink href={SITE_CONFIG.author.url}>{SITE_CONFIG.author.name}</TextLink> using Agentic
        Coding. This project reflects how professional software development should evolve.
      </Fragment>
    </SiteFooter>
  </body>
</html>
