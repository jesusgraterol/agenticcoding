---
import { ClientRouter } from 'astro:transitions';

import NavigationProgress from '../components/navigation-progress/navigation-progress.astro';
import SiteFooter from '../components/site-footer/site-footer.astro';
import SiteNavigation from '../components/site-navigation/site-navigation.astro';
import { SITE_CONFIG } from '../site.config.ts';
import {
  buildStructuredData,
  type IAlternateDocument,
  type IStructuredDataType,
} from '../utilities/seo/index.ts';
import { THEME_STORAGE_KEY } from '../utilities/theme-preference/index.ts';
import '../styles/global.css';

interface Props {
  alternateDocument?: IAlternateDocument | undefined;
  articleSection?: string | undefined;
  canonicalPath: string;
  description: string;
  title: string;
  noIndex?: boolean | undefined;
  structuredDataTitle?: string | undefined;
  structuredDataType?: IStructuredDataType | undefined;
  updatedAt?: Date | undefined;
}

const {
  alternateDocument,
  articleSection,
  canonicalPath,
  description,
  noIndex = false,
  structuredDataType,
  title,
  structuredDataTitle = title,
  updatedAt,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_CONFIG.url).toString();
const alternateDocumentUrl = alternateDocument
  ? new URL(alternateDocument.href, SITE_CONFIG.url).toString()
  : undefined;
const llmsTextUrl = new URL('/llms.txt', SITE_CONFIG.url).toString();
const openGraphImageUrl = new URL(SITE_CONFIG.openGraph.image, SITE_CONFIG.url).toString();
const structuredData = structuredDataType
  ? buildStructuredData({
      articleSection,
      canonicalUrl,
      description,
      title: structuredDataTitle,
      type: structuredDataType,
      updatedAt,
    })
  : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="author"
      content={SITE_CONFIG.author.name}
    />
    <meta
      name="theme-color"
      content={SITE_CONFIG.themeColors.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={SITE_CONFIG.themeColors.dark}
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="robots"
      content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link
      rel="canonical"
      href={canonicalUrl}
    />
    <link
      rel="describedby"
      href={llmsTextUrl}
    />
    {
      alternateDocument && alternateDocumentUrl && (
        <link
          rel="alternate"
          type={alternateDocument.mediaType}
          title={alternateDocument.title}
          href={alternateDocumentUrl}
        />
      )
    }
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <meta
      property="og:site_name"
      content={SITE_CONFIG.name}
    />
    <meta
      property="og:locale"
      content={SITE_CONFIG.openGraph.locale}
    />
    <meta
      property="og:type"
      content={structuredDataType === 'article' ? 'article' : 'website'}
    />
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonicalUrl}
    />
    <meta
      property="og:image"
      content={openGraphImageUrl}
    />
    <meta
      property="og:image:secure_url"
      content={openGraphImageUrl}
    />
    <meta
      property="og:image:type"
      content={SITE_CONFIG.openGraph.imageType}
    />
    <meta
      property="og:image:width"
      content={String(SITE_CONFIG.openGraph.width)}
    />
    <meta
      property="og:image:height"
      content={String(SITE_CONFIG.openGraph.height)}
    />
    <meta
      property="og:image:alt"
      content={SITE_CONFIG.openGraph.imageAlt}
    />
    {
      structuredDataType === 'article' && (
        <meta
          property="article:author"
          content={SITE_CONFIG.author.url}
        />
      )
    }
    {
      structuredDataType === 'article' && articleSection && (
        <meta
          property="article:section"
          content={articleSection}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={openGraphImageUrl}
    />
    <meta
      name="twitter:image:alt"
      content={SITE_CONFIG.openGraph.imageAlt}
    />

    <title>{title}</title>
    <ClientRouter fallback="swap" />
    {
      serializedStructuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializedStructuredData}
        />
      )
    }
    <script
      is:inline
      define:vars={{
        darkThemeColor: SITE_CONFIG.themeColors.dark,
        lightThemeColor: SITE_CONFIG.themeColors.light,
        themeStorageKey: THEME_STORAGE_KEY,
      }}
    >
      (() => {
        const themeValues = ['system', 'light', 'dark'];
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const getPreference = () => {
          try {
            const storedPreference = localStorage.getItem(themeStorageKey);
            return themeValues.includes(storedPreference) ? storedPreference : 'system';
          } catch {
            return 'system';
          }
        };
        const resolveTheme = (preference) =>
          preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        const applyTheme = (root = document.documentElement, preference = getPreference()) => {
          const resolvedTheme = resolveTheme(preference);
          root.classList.toggle('dark', resolvedTheme === 'dark');
          root.classList.toggle('light', resolvedTheme === 'light');
          root.dataset.resolvedTheme = resolvedTheme;
          root.dataset.themePreference = preference;
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) =>
              meta.setAttribute(
                'content',
                resolvedTheme === 'dark' ? darkThemeColor : lightThemeColor,
              ),
            );
          window.dispatchEvent(new Event('agentic-theme-applied'));
        };

        applyTheme();
        media.addEventListener('change', () => {
          if (getPreference() === 'system') applyTheme();
        });
        window.addEventListener('agentic-theme-change', (event) => {
          applyTheme(document.documentElement, event.detail.preference);
        });
        document.addEventListener('astro:before-swap', (event) => {
          applyTheme(event.newDocument.documentElement);
        });
      })();
    </script>
  </head>
  <body>
    <NavigationProgress />
    <a
      class="fixed top-2 left-2 z-[100] -translate-y-20 rounded-md bg-primary px-4 py-2 font-bold text-primary-foreground focus:translate-y-0"
      href="#main-content"
    >
      Skip to main content
    </a>
    <SiteNavigation />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
