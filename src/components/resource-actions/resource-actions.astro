---
import { BookOpen, Braces, FilePenLine, Workflow } from '@lucide/astro';
import IconTile from 'jg-personal-astro-ui/icon-tile';
import LinkCard from 'jg-personal-astro-ui/link-card';

const resources = [
  {
    description: 'Adopt a neutral, production-minded AGENTS.md in a new repository.',
    href: '/start/',
    icon: Braces,
    label: 'Open foundation',
    title: 'Start with the foundation',
  },
  {
    description: 'Install the skills and see every step of a change with example output.',
    href: '/workflow/',
    icon: Workflow,
    label: 'Open workflow',
    title: 'Run the workflow with skills',
  },
  {
    description: 'Preserve project knowledge while strengthening the engineering process.',
    href: '/refine/',
    icon: FilePenLine,
    label: 'Open prompt',
    title: 'Refine existing instructions',
  },
  {
    description:
      'Orient, control scope, recover from drift, and deepen tests where no skill applies.',
    href: '/cookbook/',
    icon: BookOpen,
    label: 'Open cookbook',
    title: 'Handle the harder moments',
  },
] as const;
---

<ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    resources.map(({ description, href, icon: Icon, label, title }) => (
      <li>
        <LinkCard
          href={href}
          title={title}
        >
          <IconTile slot="icon">
            <Icon />
          </IconTile>
          {description}
          <span
            slot="footer"
            class="text-sm font-semibold"
          >
            {label}
          </span>
        </LinkCard>
      </li>
    ))
  }
</ul>
