---
import { ArrowRight, BookOpen, Braces, FilePenLine } from '@lucide/astro';

const resources = [
  {
    description: 'Adopt a neutral, production-minded AGENTS.md in a new repository.',
    href: '/start/',
    icon: Braces,
    label: 'Open foundation',
    title: 'Start with the foundation',
  },
  {
    description: 'Preserve project knowledge while strengthening the engineering process.',
    href: '/refine/',
    icon: FilePenLine,
    label: 'Open prompt',
    title: 'Refine existing instructions',
  },
  {
    description: 'Practice planning, bounded execution, agent review, and developer acceptance.',
    href: '/cookbook/',
    icon: BookOpen,
    label: 'Open cookbook',
    title: 'Practice the workflow',
  },
] as const;
---

<div
  class="mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-3"
>
  {
    resources.map(({ description, href, icon: Icon, label, title }) => (
      <a
        class="group flex min-h-64 flex-col bg-background p-6 no-underline transition-colors hover:bg-secondary sm:p-7"
        href={href}
      >
        <Icon
          class="size-5 text-accent"
          aria-hidden="true"
        />
        <h3 class="mt-10 text-xl font-semibold tracking-tight">{title}</h3>
        <p class="mt-3 text-sm leading-6 text-muted">{description}</p>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold">
          {label}
          <ArrowRight
            class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
            aria-hidden="true"
          />
        </span>
      </a>
    ))
  }
</div>
