---
const stages = [
  {
    name: 'Demonstrate',
    text: 'Work closely. Make important decisions visible. Correct what does not fit and explain why.',
  },
  {
    name: 'Codify',
    text: 'Turn recurring decisions into instructions, architecture, tests, schemas, documentation, and automation.',
  },
  {
    name: 'Delegate',
    text: 'Grant larger, more complete tasks as the surrounding system becomes clearer and more dependable.',
  },
  {
    name: 'Verify',
    text: 'Keep checks, agent review, and developer inspection as the corrective layer that improves the next cycle.',
  },
] as const;
---

<ol class="mt-12 grid gap-0 border-l border-border-strong md:grid-cols-4 md:border-t md:border-l-0">
  {
    stages.map(({ name, text }, index) => (
      <li class="relative p-6 md:pt-10">
        <span
          class="absolute top-7 -left-1.5 size-3 rounded-full border-2 border-background bg-chart-4 md:-top-1.5 md:left-7"
          aria-hidden="true"
        />
        <span class="font-mono text-xs font-bold text-muted">YEAR 0{index + 1}</span>
        <h3 class="mt-3 text-2xl font-extrabold tracking-tight">{name}</h3>
        <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
      </li>
    ))
  }
</ol>
