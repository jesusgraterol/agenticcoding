---
import { SITE_CONFIG } from '../../site.config.ts';
import CopyControl from '../copy-control/copy-control.astro';

interface Props {
  // id of the copied command element; unique within the page
  id: string;
}

// shell prompt shown before the command but never copied
const SHELL_PROMPT = '$';

const { id } = Astro.props;
---

<div class="grid min-w-0 gap-3">
  <figure class="min-w-0 overflow-hidden rounded-xl border border-border-strong bg-code">
    <figcaption
      class="flex flex-wrap items-center justify-between gap-3 border-b border-border py-2 pr-2 pl-4"
    >
      <span class="font-mono text-xs font-semibold text-muted">
        Install {SITE_CONFIG.skills.name} from your repository's root
      </span>
      <CopyControl
        label="Copy install command"
        sourceId={id}
      />
    </figcaption>
    <p class="flex gap-3 px-4 py-4 font-mono text-sm leading-6">
      <span
        class="text-accent select-none"
        aria-hidden="true"
        >{SHELL_PROMPT}</span
      >
      <code
        id={id}
        class="min-w-0 wrap-anywhere"
        >{SITE_CONFIG.skills.installCommand}</code
      >
    </p>
  </figure>
  <p class="text-sm leading-6 text-muted">{SITE_CONFIG.skills.verificationNote}</p>
</div>
