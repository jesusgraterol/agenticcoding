---
import { ArrowUpRight, LayoutGrid, Link2, Terminal } from '@lucide/astro';

import { SITE_CONFIG } from '../../site.config.ts';
import InstallCommand from '../install-command/install-command.astro';

// the jg-skills home page sections each card opens
const BROWSE_URL = new URL('#skills', SITE_CONFIG.skills.url);
const INSTALL_URL = new URL('#install', SITE_CONFIG.skills.url);

/**
 * Splits a card's link into the host and path its destination line shows, so a narrow card can
 * break the line between them instead of inside a word.
 * @param url The card's absolute link.
 * @returns The host, and the path with its fragment.
 */
const toDestination = (url: URL): { host: string; path: string } => ({
  host: url.host,
  path: `${url.pathname}${url.hash}`,
});

const browseDestination = toDestination(BROWSE_URL);
const installDestination = toDestination(INSTALL_URL);
---

<section
  id="skills"
  class="section-space scroll-mt-16 border-t border-border bg-secondary/35"
  aria-labelledby="skills-bridge-title"
>
  <div class="page-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">jg-skills</p>
      <h2
        id="skills-bridge-title"
        class="section-title mx-auto mt-4"
      >
        Give your agent a workflow to run.
      </h2>
      <p class="lede mx-auto mt-6 text-base sm:text-lg">
        Your <code class="font-mono text-[0.92em]">AGENTS.md</code> sets the standards. jg-skills runs
        the workflow on top of them: skills you invoke for each step, and skills your agent loads on its
        own when a task touches their stack.
      </p>
    </div>
    {/* the connector between the two items is decorative, so the list reads as two items */}
    <ol
      class="mx-auto mt-10 grid max-w-2xl gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center sm:gap-0"
      aria-label="How AGENTS.md and jg-skills fit together"
      data-skills-bridge-strip
    >
      <li class="rounded-xl border border-border bg-surface p-5 shadow-surface">
        <code class="font-mono text-base font-bold">AGENTS.md</code>
        <span class="mt-1 block text-sm text-muted">Sets the standards</span>
      </li>
      <li
        class="flex flex-col items-center justify-center text-muted sm:flex-row"
        aria-hidden="true"
      >
        <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
        <span
          class="inline-flex size-8 items-center justify-center rounded-full border border-border bg-background"
        >
          <Link2
            class="size-4"
            size={16}
          />
        </span>
        <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
      </li>
      <li class="rounded-xl bg-primary p-5 text-primary-foreground shadow-raised">
        <code class="font-mono text-base font-bold">jg-skills</code>
        <span class="mt-1 block text-sm text-accent-on-primary">Runs the workflow</span>
      </li>
    </ol>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      <li>
        {/* the whole card is the link target, so the card draws the keyboard focus ring for it */}
        <article
          class="relative flex h-full flex-col rounded-xl border border-border bg-surface p-5 shadow-surface transition-colors hover:border-border-strong has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-focus motion-reduce:transition-none"
          data-skills-bridge-card
        >
          {/* the badge shares the top row with the corner arrow, raised to center on it */}
          <p
            class="-mt-[3px] w-fit rounded-full border border-border px-2.5 py-0.5 font-mono text-xs font-semibold text-muted"
          >
            Every skill
          </p>
          <div class="mt-4 flex items-center gap-4">
            <span
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
              aria-hidden="true"
            >
              <LayoutGrid
                class="size-5"
                size={20}
              />
            </span>
            <h3 class="min-w-0 text-lg font-semibold tracking-tight">
              <a
                class="no-underline outline-none after:absolute after:inset-0 after:rounded-xl"
                href={BROWSE_URL.href}
                target="_blank"
                rel="noreferrer"
                >Browse the skills<ArrowUpRight
                  class="absolute top-5 right-5 size-4 text-muted"
                  aria-hidden="true"
                /><span class="sr-only"> (opens in a new tab)</span></a
              >
            </h3>
          </div>
          <p class="mt-4 text-sm leading-6 text-pretty text-muted">
            Each skill's purpose, what it may change, and its full instructions.
          </p>
          {/* the two kinds of skill that the lede introduces */}
          <dl class="mt-5 grid flex-1 content-start gap-4 border-t border-border pt-5 text-sm">
            <div>
              <dt class="font-semibold">Skills you invoke</dt>
              <dd class="mt-1 leading-6 text-pretty text-muted">
                Plan, build, review, and push a change, one step at a time.
              </dd>
            </div>
            <div>
              <dt class="font-semibold">Skills that load on their own</dt>
              <dd class="mt-1 leading-6 text-pretty text-muted">
                Standards for the stack a task touches, such as its frontend, database, or tests.
              </dd>
            </div>
          </dl>
          <p
            class="mt-5 font-mono text-xs wrap-anywhere text-muted"
            data-skills-bridge-destination
          >
            {browseDestination.host}
            <wbr />
            {browseDestination.path}
          </p>
        </article>
      </li>
      <li>
        {/* only the title is a link, because the card also holds the copy control */}
        <article
          class="relative flex h-full flex-col rounded-xl border border-border bg-surface p-5 shadow-surface"
          data-skills-bridge-card
        >
          <p
            class="-mt-[3px] w-fit rounded-full border border-border px-2.5 py-0.5 font-mono text-xs font-semibold text-muted"
          >
            One command
          </p>
          <div class="mt-4 flex items-center gap-4">
            <span
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
              aria-hidden="true"
            >
              <Terminal
                class="size-5"
                size={20}
              />
            </span>
            <h3 class="min-w-0 text-lg font-semibold tracking-tight">
              <a
                class="underline-offset-4 hover:underline"
                href={INSTALL_URL.href}
                target="_blank"
                rel="noreferrer"
                >Install them<ArrowUpRight
                  class="absolute top-5 right-5 size-4 text-muted"
                  aria-hidden="true"
                /><span class="sr-only"> (opens in a new tab)</span></a
              >
            </h3>
          </div>
          <div class="mt-4 flex-1">
            <InstallCommand id="skills-bridge-install-command" />
          </div>
          <p
            class="mt-5 font-mono text-xs wrap-anywhere text-muted"
            data-skills-bridge-destination
          >
            {installDestination.host}
            <wbr />
            {installDestination.path}
          </p>
        </article>
      </li>
    </ul>
  </div>
</section>
