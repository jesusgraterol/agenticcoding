---
import { ArrowUpRight, LayoutGrid, Link2, Terminal } from '@lucide/astro';
import AgenticCodingMark from 'jg-personal-astro-ui/agentic-coding-mark';
import Badge from 'jg-personal-astro-ui/badge';
import Card from 'jg-personal-astro-ui/card';
import IconTile from 'jg-personal-astro-ui/icon-tile';
import JgMark from 'jg-personal-astro-ui/jg-mark';
import LinkCard from 'jg-personal-astro-ui/link-card';
import NewTabMarker from 'jg-personal-astro-ui/new-tab-marker';
import Section from 'jg-personal-astro-ui/section';

import { SITE_CONFIG } from '../../site.config.ts';
import SkillsInstall from '../skills-install/skills-install.astro';

// the jg-skills home page sections each card opens
const BROWSE_URL = new URL('#skills', SITE_CONFIG.skills.url);
const INSTALL_URL = new URL('#install', SITE_CONFIG.skills.url);

/**
 * Splits a card's link into the host and path its destination line shows, so a narrow card can
 * break the line between them instead of inside a word.
 * @param url The card's absolute link.
 * @returns The host, and the path with its fragment.
 */
const toDestination = (url: URL): { host: string; path: string } => ({
  host: url.host,
  path: `${url.pathname}${url.hash}`,
});

const browseDestination = toDestination(BROWSE_URL);
const installDestination = toDestination(INSTALL_URL);
---

<Section
  id="skills"
  align="center"
  border={false}
  class="bg-secondary/35"
  eyebrow="jg-skills"
  title="Give your agent a workflow to run."
>
  <p
    slot="header-end"
    class="lede mx-auto mt-5"
  >
    Your <code class="font-mono text-[0.92em]">AGENTS.md</code> sets the standards. jg-skills runs the
    workflow on top of them: skills you invoke for each step, and skills your agent loads on its own when
    a task touches their stack.
  </p>
  {/* the connector between the two items is decorative, so the list reads as two items */}
  <ol
    class="mx-auto mt-10 grid max-w-2xl gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center sm:gap-0"
    aria-label="How AGENTS.md and jg-skills fit together"
    data-skills-bridge-strip
  >
    {/* each item carries the mark of the project that provides it */}
    <li
      class="flex items-center gap-4 rounded-xl border border-border bg-surface p-5 shadow-surface"
    >
      <AgenticCodingMark class="size-10 shrink-0" />
      <div class="min-w-0">
        <code class="font-mono text-base font-bold">AGENTS.md</code>
        <span class="mt-1 block text-sm text-muted">Sets the standards</span>
      </div>
    </li>
    <li
      class="flex flex-col items-center justify-center text-muted sm:flex-row"
      aria-hidden="true"
    >
      <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
      <span
        class="inline-flex size-8 items-center justify-center rounded-full border border-border bg-background"
      >
        <Link2
          class="size-4"
          size={16}
        />
      </span>
      <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
    </li>
    <li
      class="flex items-center gap-4 rounded-xl bg-inverse p-5 text-inverse-foreground shadow-raised"
    >
      <JgMark class="size-10 shrink-0" />
      <div class="min-w-0">
        <code class="font-mono text-base font-bold">jg-skills</code>
        <span class="mt-1 block text-sm text-inverse-accent">Runs the workflow</span>
      </div>
    </li>
  </ol>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    <li>
      <LinkCard
        external
        href={BROWSE_URL.href}
        title="Browse the skills"
        data-skills-bridge-card
      >
        <IconTile slot="icon">
          <LayoutGrid />
        </IconTile>
        <Badge
          slot="kicker"
          class="mb-2"
          variant="outline"
        >
          Every skill
        </Badge>
        <p class="text-pretty">
          Each skill's purpose, what it may change, and its full instructions.
        </p>
        {/* the two kinds of skill that the lede introduces */}
        <dl class="mt-5 grid content-start gap-4 border-t border-border pt-5">
          <div>
            <dt class="font-semibold text-foreground">Skills you invoke</dt>
            <dd class="mt-1 text-pretty">
              Plan, build, review, and push a change, one step at a time.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-foreground">Skills that load on their own</dt>
            <dd class="mt-1 text-pretty">
              Standards for the stack a task touches, such as its frontend, database, or tests.
            </dd>
          </div>
        </dl>
        <p
          class="mt-5 font-mono text-xs wrap-anywhere"
          data-skills-bridge-destination
        >
          {browseDestination.host}
          <wbr />
          {browseDestination.path}
        </p>
      </LinkCard>
    </li>
    <li>
      {/* only the title is a link, because the card also holds the copy button */}
      <Card
        as="article"
        class="relative flex h-full flex-col"
        data-skills-bridge-card
      >
        <ArrowUpRight
          class="absolute top-5 right-5 size-4 text-muted"
          aria-hidden="true"
        />
        <div class="flex items-start gap-3">
          <IconTile>
            <Terminal />
          </IconTile>
          <div class="min-w-0 flex-1">
            <Badge
              class="mb-2"
              variant="outline"
            >
              One command
            </Badge>
            <h3 class="text-base font-semibold tracking-tight">
              <a
                class="underline-offset-4 hover:underline"
                href={INSTALL_URL.href}
                target="_blank"
                rel="noreferrer"
                >Install them<NewTabMarker icon={false} /></a
              >
            </h3>
          </div>
        </div>
        <div class="mt-4 flex-1">
          <SkillsInstall id="skills-bridge-install-command" />
        </div>
        <p
          class="mt-5 font-mono text-xs wrap-anywhere text-muted"
          data-skills-bridge-destination
        >
          {installDestination.host}
          <wbr />
          {installDestination.path}
        </p>
      </Card>
    </li>
  </ul>
</Section>
