---
import { GitBranch, Menu } from '@lucide/astro';

import { SITE_CONFIG } from '../../site.config.ts';
import BrandLogo from '../brand-logo/brand-logo.astro';
import ThemeControl from '../theme-control/theme-control.astro';

const currentPath = Astro.url.pathname;
const isActivePath = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="min-w-0 no-underline"
      aria-label="Agentic Coding home"
    >
      <BrandLogo compact />
    </a>

    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Primary navigation"
    >
      {
        SITE_CONFIG.navigation.slice(1).map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-semibold text-muted no-underline hover:bg-secondary hover:text-foreground',
              isActivePath(href) && 'bg-secondary text-foreground',
            ]}
            aria-current={isActivePath(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <a
        href={SITE_CONFIG.repositoryUrl}
        class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-muted no-underline hover:bg-secondary hover:text-foreground"
        target="_blank"
        rel="noreferrer"
      >
        <GitBranch
          class="size-4"
          aria-hidden="true"
        />
        Source
      </a>
      <ThemeControl />
    </nav>

    <details class="group relative lg:hidden">
      <summary
        class="flex min-h-11 list-none items-center gap-2 rounded-md border border-border-strong px-3 text-sm font-semibold marker:content-none"
      >
        <Menu
          class="size-4"
          aria-hidden="true"
        />
        Menu
      </summary>
      <div
        class="absolute right-0 mt-2 w-[min(19rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label="Mobile navigation"
        >
          {
            SITE_CONFIG.navigation.slice(1).map(({ href, label }) => (
              <a
                href={href}
                class:list={[
                  'rounded-md px-3 py-2.5 text-sm font-semibold no-underline hover:bg-secondary',
                  isActivePath(href) && 'bg-secondary',
                ]}
                aria-current={isActivePath(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
          <a
            href={SITE_CONFIG.repositoryUrl}
            class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold no-underline hover:bg-secondary"
            target="_blank"
            rel="noreferrer"
          >
            <GitBranch
              class="size-4"
              aria-hidden="true"
            />
            Source
          </a>
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl />
        </div>
      </div>
    </details>
  </div>
</header>
