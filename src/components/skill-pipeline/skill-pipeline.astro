---
import { ArrowRight } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import SegmentedControl from 'jg-personal-astro-ui/segmented-control';
import Step from 'jg-personal-astro-ui/step';
import Steps from 'jg-personal-astro-ui/steps';

import {
  REVIEW_OUTCOMES,
  WORKFLOW_STAGES,
  WORKFLOW_STEP_MARKER_LABELS,
  WORKFLOW_STEPS,
  type IWorkflowStage,
} from '../../site.config.ts';

// how jg-execute runs in each mode, and who runs the Ship stage
const PIPELINE_MODES = {
  supervised: {
    label: 'Supervised',
    shipNote: 'You run these yourself when you are ready.',
  },
  autonomous: {
    label: 'Autonomous',
    shipNote:
      'jg-execute auto runs jg-review and jg-push after each milestone, within its stop conditions.',
  },
} as const;

const stages = (Object.keys(WORKFLOW_STAGES) as IWorkflowStage[]).map((stage, index) => ({
  ...WORKFLOW_STAGES[stage],
  position: String(index + 1).padStart(2, '0'),
  stage,
  steps: WORKFLOW_STEPS.filter((step) => step.stage === stage),
}));
---

<div class="group/pipeline mt-12 grid gap-6">
  <SegmentedControl
    class="justify-self-center"
    legend="How the agent runs the change"
    legendHidden
    name="pipeline-mode"
    options={(['supervised', 'autonomous'] as const).map((mode) => ({
      label: PIPELINE_MODES[mode].label,
      value: mode,
    }))}
  />

  <ol class="grid gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-3">
    {
      stages.map(({ label, position, stage, steps, summary }) => (
        <li
          class="flex flex-col bg-background p-5 sm:p-6"
          data-pipeline-stage={stage}
        >
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs font-bold text-accent">{position}</span>
            <h3 class="text-xl font-semibold tracking-tight">{label}</h3>
          </div>
          <p class="mt-2 text-sm leading-6 text-muted">{summary}</p>
          <Steps
            class="mt-5"
            label={label + ' skills'}
          >
            {steps.map((step) => (
              <Step title={step.skill}>
                <a
                  slot="title"
                  class="group flex items-center justify-between gap-3 rounded-lg border border-border bg-surface px-3 py-2.5 no-underline transition-colors hover:border-border-strong hover:bg-secondary motion-reduce:transition-none"
                  href={`/workflow/#${step.skill}`}
                >
                  <span class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    {step.skill === 'jg-execute' ? (
                      <code class="text-sm font-bold text-accent">
                        <span class="group-has-[[data-segment=autonomous]:checked]/pipeline:hidden">
                          jg-execute
                        </span>
                        <span class="hidden group-has-[[data-segment=autonomous]:checked]/pipeline:inline">
                          jg-execute auto
                        </span>
                      </code>
                    ) : (
                      <code class="text-sm font-bold text-accent">{step.skill}</code>
                    )}
                    {step.marker && (
                      <span class="text-xs text-muted">
                        {WORKFLOW_STEP_MARKER_LABELS[step.marker]}
                      </span>
                    )}
                  </span>
                  <ArrowRight
                    class="size-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none"
                    aria-hidden="true"
                  />
                </a>
              </Step>
            ))}
          </Steps>
          {stage === 'ship' && (
            <p class="mt-4 text-sm leading-6 font-semibold">
              <span class="group-has-[[data-segment=autonomous]:checked]/pipeline:hidden">
                {PIPELINE_MODES.supervised.shipNote}
              </span>
              <span class="hidden group-has-[[data-segment=autonomous]:checked]/pipeline:inline">
                {PIPELINE_MODES.autonomous.shipNote}
              </span>
            </p>
          )}
        </li>
      ))
    }
  </ol>

  <div
    class="grid gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-[1.4fr_1fr]"
  >
    <div class="bg-surface p-5 sm:p-6">
      <p class="font-mono text-xs font-bold text-muted uppercase">After review, you choose</p>
      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          REVIEW_OUTCOMES.map(({ label, text }) => (
            <div class="border-l-2 border-accent pl-3">
              <dt class="font-semibold">{label}</dt>
              <dd class="mt-1 text-sm leading-6 text-muted">{text}</dd>
            </div>
          ))
        }
      </dl>
      <p
        class="mt-4 hidden text-sm leading-6 text-muted group-has-[[data-segment=autonomous]:checked]/pipeline:block"
      >
        In an autonomous run, the review gate settles each milestone and you judge the published
        result.
      </p>
    </div>
    <div class="bg-inverse p-5 text-inverse-foreground sm:p-6">
      <p class="font-mono text-xs font-bold text-inverse-foreground/60 uppercase">Publication</p>
      <p class="mt-3 leading-7 font-semibold">
        Publish only when explicitly authorized: <code class="text-inverse-accent">jg-push</code>{
          ' '
        }for one change, or <code class="text-inverse-accent">jg-execute auto</code> for a whole run.
      </p>
      <p class="mt-2 text-sm leading-6 text-inverse-foreground/70">
        Implementation authority alone never publishes.
      </p>
    </div>
  </div>

  <Button
    class="justify-self-center"
    href="/workflow/"
    variant="link"
  >
    See every step with example output
    <ArrowRight
      class="size-4"
      aria-hidden="true"
    />
  </Button>
</div>
