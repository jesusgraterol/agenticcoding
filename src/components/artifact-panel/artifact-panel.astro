---
import Badge from 'jg-personal-astro-ui/badge';

import type { IArtifact, IArtifactLine } from '../../content/index.ts';

interface Props {
  artifact: IArtifact;
}

// treatment of each line kind; diff markers and labels keep meaning independent of color
const LINE_STYLES = {
  added: { className: 'bg-success/10', label: 'Added: ', marker: '+' },
  heading: { className: 'font-bold', label: '', marker: '' },
  muted: { className: 'text-muted', label: '', marker: '' },
  removed: { className: 'bg-danger/10', label: 'Removed: ', marker: '-' },
  text: { className: '', label: '', marker: '' },
} as const satisfies Record<
  IArtifactLine['kind'],
  { className: string; label: string; marker: string }
>;

// status dot color for each tone; the visible label carries the meaning
const STATUS_DOTS = {
  error: 'bg-danger',
  neutral: 'bg-muted',
  success: 'bg-success',
  warning: 'bg-warning',
} as const satisfies Record<NonNullable<IArtifact['status']>['tone'], string>;

const { artifact } = Astro.props;
---

<figure class="min-w-0 overflow-hidden rounded-lg border border-border bg-code">
  <figcaption
    class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1.5 border-b border-border px-3 py-2"
  >
    <span class="min-w-0 font-mono text-xs font-semibold wrap-anywhere">{artifact.title}</span>
    {
      artifact.status && (
        <Badge
          class="shrink-0"
          mono={false}
          variant="neutral"
        >
          {/* a neutral badge on the code surface, so the label keeps its contrast in every tone */}
          <span
            class:list={['size-1.5 rounded-full', STATUS_DOTS[artifact.status.tone]]}
            aria-hidden="true"
          />
          {artifact.status.label}
        </Badge>
      )
    }
  </figcaption>
  <code class="block py-2 text-xs leading-5">
    {
      artifact.lines.map(({ kind, text }) => (
        <span class:list={['flex gap-1.5 px-2 sm:gap-2 sm:px-3', LINE_STYLES[kind].className]}>
          <span
            class="w-2 shrink-0 text-muted select-none"
            aria-hidden="true"
          >
            {LINE_STYLES[kind].marker}
          </span>
          <span class="min-w-0 wrap-anywhere whitespace-pre-wrap">
            {LINE_STYLES[kind].label && <span class="sr-only">{LINE_STYLES[kind].label}</span>}
            {text}
          </span>
        </span>
      ))
    }
  </code>
</figure>
