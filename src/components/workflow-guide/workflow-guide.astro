---
import { ChevronRight } from '@lucide/astro';
import Badge from 'jg-personal-astro-ui/badge';
import Card from 'jg-personal-astro-ui/card';
import SegmentedControl from 'jg-personal-astro-ui/segmented-control';
import TextLink from 'jg-personal-astro-ui/text-link';

import {
  REVIEW_OUTCOMES,
  SITE_CONFIG,
  SUPPORTING_SKILLS,
  WORKFLOW_STAGES,
  WORKFLOW_STEP_MARKER_LABELS,
  WORKFLOW_STEPS,
  type IWorkflowStage,
} from '../../site.config.ts';
import SessionTranscript from '../session-transcript/session-transcript.astro';
import SkillsInstall from '../skills-install/skills-install.astro';

import {
  AUTONOMOUS_CYCLE,
  AUTONOMOUS_EXECUTE_EXAMPLE,
  AUTONOMOUS_STOP_CONDITIONS,
  STEP_EXAMPLES,
  SUPERVISED_EXECUTE_EXAMPLE,
} from './constants.ts';

// execution modes in toggle order, with the one-line contract shown for each
const EXECUTE_MODES = {
  supervised: {
    label: 'Supervised',
    text: 'Builds the next milestone, or the whole plan when it has none, runs its checks, and stops. You run jg-review and jg-push.',
  },
  autonomous: {
    label: 'Autonomous',
    text: 'Builds, reviews, and pushes every remaining milestone, one at a time. It asks first before pushing to the default branch or publishing commits that were already unpushed.',
  },
} as const;

const stages = (Object.keys(WORKFLOW_STAGES) as IWorkflowStage[]).map((stage) => ({
  ...WORKFLOW_STAGES[stage],
  stage,
  steps: WORKFLOW_STEPS.filter((step) => step.stage === stage),
}));

/** Builds the public jg-skills page URL for one skill. */
const buildSkillUrl = (skill: string): string =>
  new URL(`skills/${skill}/`, SITE_CONFIG.skills.url).toString();
---

<div class="grid gap-16 sm:gap-20">
  <section
    class="grid gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start lg:gap-12"
    aria-labelledby="workflow-setup-title"
  >
    <div>
      <p class="eyebrow">Before the first change</p>
      <h2
        id="workflow-setup-title"
        class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl"
      >
        Install the skills once per repository.
      </h2>
      <p class="mt-4 leading-7 text-muted">
        Each skill runs only when you invoke it by name: <code
          class="rounded-md bg-code px-1.5 py-0.5 text-sm text-accent">/jg-plan</code
        > in Claude Code, <code class="rounded-md bg-code px-1.5 py-0.5 text-sm text-accent"
          >$jg-plan</code
        > in Codex. Skills defer engineering standards to your repository's <code>AGENTS.md</code>,
        so <TextLink
          class="text-foreground"
          href="/start/"
          >start with the foundation</TextLink
        >.
      </p>
    </div>
    <SkillsInstall id="workflow-install-command" />
  </section>

  <nav
    class="grid gap-4 rounded-xl border border-border p-5 sm:grid-cols-3 sm:p-6"
    aria-label="Workflow steps"
  >
    {
      stages.map(({ label, stage, steps }) => (
        <div>
          <a
            class="font-mono text-xs font-bold text-muted uppercase underline-offset-4 hover:underline"
            href={`#${stage}-stage`}
          >
            {label}
          </a>
          <ul class="mt-3 grid gap-1.5">
            {steps.map(({ skill }) => (
              <li>
                <a
                  class="font-mono text-sm font-semibold underline-offset-4 hover:underline"
                  href={`#${skill}`}
                >
                  {skill}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  {
    stages.map(({ label, stage, steps, summary }) => (
      <section
        id={`${stage}-stage`}
        class="scroll-mt-24"
        aria-labelledby={`${stage}-stage-title`}
      >
        <div class="flex flex-col gap-1 border-b border-border-strong pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <h2
            id={`${stage}-stage-title`}
            class="text-3xl font-semibold tracking-tight"
          >
            {label}
          </h2>
          <p class="text-sm text-muted">{summary}</p>
        </div>
        <div class="mt-10 grid gap-14">
          {steps.map((step) => (
            <article
              id={step.skill}
              class="grid scroll-mt-24 gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12"
              aria-labelledby={`${step.skill}-title`}
            >
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3
                    id={`${step.skill}-title`}
                    class="font-mono text-xl font-bold text-accent"
                  >
                    {step.skill}
                  </h3>
                  {step.marker && (
                    <Badge
                      mono={false}
                      variant="outline"
                    >
                      {WORKFLOW_STEP_MARKER_LABELS[step.marker]}
                    </Badge>
                  )}
                </div>
                <p class="mt-3 leading-7">{step.purpose}</p>
                <dl class="mt-4">
                  <dt class="font-mono text-xs font-bold text-muted uppercase">May change</dt>
                  <dd class="mt-1 text-sm leading-6">{step.mayChange}</dd>
                </dl>
                {step.skill === 'jg-review' && (
                  <div class="mt-5">
                    <p class="text-sm font-semibold">Then you choose the outcome:</p>
                    <dl class="mt-3 grid gap-2">
                      {REVIEW_OUTCOMES.map(({ label: outcome, text }) => (
                        <div class="grid gap-0.5 border-l-2 border-accent pl-3">
                          <dt class="text-sm font-bold">{outcome}</dt>
                          <dd class="text-sm leading-6 text-muted">{text}</dd>
                        </div>
                      ))}
                    </dl>
                    <p class="mt-3 text-sm leading-6 text-muted">
                      For a branch, run{' '}
                      <code class="text-accent">jg-review &lt;target-branch&gt;</code>.
                    </p>
                  </div>
                )}
                {step.skill === 'jg-push' && (
                  <p class="mt-5 border-l-2 border-accent pl-3 text-sm leading-6">
                    Publication always needs its own grant: <code class="text-accent">jg-push</code>{' '}
                    for one change, or <code class="text-accent">jg-execute auto</code> for a whole
                    run.
                  </p>
                )}
                <p class="mt-5 text-sm">
                  <TextLink
                    href={buildSkillUrl(step.skill)}
                    external
                  >
                    Full instructions on {SITE_CONFIG.skills.name}
                  </TextLink>
                </p>
              </div>
              <div class="min-w-0">
                {step.skill === 'jg-execute' ? (
                  <div class="group/execute grid gap-5">
                    <SegmentedControl
                      legend="How jg-execute runs"
                      legendHidden
                      name="execute-mode"
                      options={(['supervised', 'autonomous'] as const).map((mode) => ({
                        label: EXECUTE_MODES[mode].label,
                        value: mode,
                      }))}
                    />
                    <div
                      class="grid gap-4 group-has-[[data-segment=autonomous]:checked]/execute:hidden"
                      data-execute-panel="supervised"
                    >
                      <p class="text-sm leading-6 text-muted">{EXECUTE_MODES.supervised.text}</p>
                      <SessionTranscript
                        label="Example: jg-execute in supervised mode"
                        messages={SUPERVISED_EXECUTE_EXAMPLE}
                      />
                    </div>
                    <div
                      class="hidden gap-5 group-has-[[data-segment=autonomous]:checked]/execute:grid"
                      data-execute-panel="autonomous"
                    >
                      <p class="text-sm leading-6 text-muted">{EXECUTE_MODES.autonomous.text}</p>
                      <ol
                        class="flex flex-wrap items-center gap-1.5"
                        aria-label="What an autonomous run repeats for each milestone"
                      >
                        {AUTONOMOUS_CYCLE.map((cycleStep, index) => (
                          <li class="inline-flex items-center gap-1.5">
                            {index > 0 && (
                              <ChevronRight
                                class="size-3.5 text-muted"
                                aria-hidden="true"
                              />
                            )}
                            <span class="rounded-md border border-border bg-surface px-2 py-1 font-mono text-xs font-semibold">
                              {cycleStep}
                            </span>
                          </li>
                        ))}
                      </ol>
                      <SessionTranscript
                        label="Example: jg-execute in autonomous mode"
                        messages={AUTONOMOUS_EXECUTE_EXAMPLE}
                      />
                      <div class="rounded-lg border border-border p-4">
                        <p class="text-sm font-semibold">It stops and hands control back on</p>
                        <ul class="mt-2 grid list-disc gap-1 pl-5 text-sm leading-6 text-muted">
                          {AUTONOMOUS_STOP_CONDITIONS.map((condition) => (
                            <li>{condition}</li>
                          ))}
                        </ul>
                        <p class="mt-3 text-sm leading-6">
                          It never weakens a test, check, or finding to keep going.
                        </p>
                      </div>
                    </div>
                  </div>
                ) : (
                  <SessionTranscript
                    label={`Example: ${step.skill}`}
                    messages={STEP_EXAMPLES[step.skill]}
                  />
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section
    id="more-skills"
    class="scroll-mt-24 border-t border-border-strong pt-12"
    aria-labelledby="more-skills-title"
  >
    <h2
      id="more-skills-title"
      class="text-3xl font-semibold tracking-tight"
    >
      More skills
    </h2>
    <p class="mt-3 max-w-2xl leading-7 text-muted">
      These skills support the workflow without being one of its steps.
    </p>
    <ul class="mt-6 grid gap-4 lg:grid-cols-3">
      {
        SUPPORTING_SKILLS.map(({ mayChange, purpose, skill }) => (
          <Card
            as="li"
            class="grid content-start gap-2"
          >
            <p class="font-mono text-lg font-bold text-accent">{skill}</p>
            <p class="leading-7">{purpose}</p>
            <p class="text-sm text-muted">May change: {mayChange}</p>
            <p class="text-sm">
              <TextLink
                href={buildSkillUrl(skill)}
                external
              >
                {`${skill} on ${SITE_CONFIG.skills.name}`}
              </TextLink>
            </p>
          </Card>
        ))
      }
    </ul>
    <p class="mt-8 leading-7">
      For recurring situations no skill covers, such as orienting in a new codebase or recovering
      from drift, use the <TextLink
        class="text-foreground"
        href="/cookbook/"
        >cookbook</TextLink
      >.
    </p>
  </section>
</div>
