---
/*
 * The six layers of the engineering contract. Each pairs a short rule with one concrete example;
 * examples that describe a skill must match what it may change in the jg-skills README.
 */
const contractLayers = [
  {
    example: 'jg-plan writes plan.md and never touches code.',
    name: 'Authority',
    question: 'who may act',
    text: 'An invoked skill runs its own workflow. Everything else starts as ordinary intent.',
  },
  {
    example: 'Read the README, then the smallest complete affected path.',
    name: 'Evidence',
    question: 'what is true',
    text: 'Repository facts beat generic assumptions.',
  },
  {
    example: 'Extend src/tokens/; do not add a second keys table.',
    name: 'Ownership',
    question: 'where work belongs',
    text: 'Extend the module that already owns the behavior.',
  },
  {
    example: 'Code, tests, errors, and docs land in the same change.',
    name: 'Coherence',
    question: 'what stays aligned',
    text: 'Behavior ships with everything that keeps it true.',
  },
  {
    example: 'jg-review: findings first, then a readiness verdict.',
    name: 'Judgment',
    question: 'what proves readiness',
    text: 'The agent attacks its own work; the developer decides.',
  },
  {
    example: 'jg-push per change, or jg-execute autonomous per run.',
    name: 'Publication',
    question: 'what may leave',
    text: 'Commits and pushes need an explicit grant.',
  },
] as const;
---

<figure class="mt-12 border-y border-border bg-surface sm:overflow-hidden sm:rounded-xl sm:border">
  <figcaption
    class="flex flex-wrap items-center justify-between gap-3 border-b border-border py-4 font-mono text-xs text-muted sm:px-6"
  >
    <span>engineering-contract.layers</span>
    <span>one coherent state</span>
  </figcaption>
  <ol class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
    {
      contractLayers.map(({ example, name, question, text }, index) => (
        <li class="flex flex-col bg-background py-6 sm:p-6">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-mono text-xs font-bold text-accent">
              LAYER {String(index + 1).padStart(2, '0')}
            </span>
            <span class="font-mono text-xs text-muted">{question}</span>
          </div>
          <h3 class="mt-8 text-xl font-semibold tracking-tight">{name}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{text}</p>
          <p class="mt-auto pt-5">
            <code class="block rounded-md bg-code px-3 py-2 text-xs leading-5 wrap-anywhere">
              {example}
            </code>
          </p>
        </li>
      ))
    }
  </ol>
</figure>
