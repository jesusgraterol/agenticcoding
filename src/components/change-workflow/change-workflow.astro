---
import { ArrowDown, CircleCheck } from '@lucide/astro';

const stages = [
  {
    name: 'Plan',
    summary: 'Understand the problem and establish the intended final state.',
    points: [
      'Inspect the relevant codebase',
      'Clarify intent and constraints',
      'Identify ownership, contracts, risks, and tests',
      'Obtain approval before implementation',
    ],
  },
  {
    name: 'Breakdown',
    summary: 'Turn the approved strategy into coherent reviewable slices.',
    points: [
      'Preserve the plan instead of redesigning it',
      'Order work by real dependencies',
      'Keep behavior with tests, docs, and migrations',
      'Give every slice a review checkpoint',
    ],
  },
  {
    name: 'Execute',
    summary: 'Implement only the currently authorized scope.',
    points: [
      'Reuse the existing architecture',
      'Avoid adjacent cleanup',
      'Verify each logical step',
      'Stop before the next unauthorized milestone',
    ],
  },
  {
    name: 'Review',
    summary: 'Assume plausible-looking work can still be wrong.',
    points: [
      'Inspect correctness, regression risk, and scope',
      'Challenge test depth and security',
      'Check maintainability and documentation',
      'Report a clear readiness verdict',
    ],
  },
] as const;
---

<div
  class="mt-12 grid gap-3 lg:grid-cols-4"
  aria-label="Plan, Breakdown, Execute, Review workflow"
>
  {
    stages.map(({ name, points, summary }, index) => (
      <div class="contents">
        <article
          class="group relative rounded-xl border border-border bg-surface p-5 shadow-surface transition-transform duration-200 focus-within:-translate-y-1 hover:-translate-y-1 focus:-translate-y-1 motion-reduce:transform-none"
          tabindex="0"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-xs font-bold text-muted">0{index + 1}</span>
            <CircleCheck
              class="size-5 text-accent opacity-40 group-hover:opacity-100 group-focus:opacity-100"
              aria-hidden="true"
            />
          </div>
          <h3 class="mt-8 text-2xl font-extrabold tracking-tight">{name}</h3>
          <p class="mt-3 text-sm leading-6 text-muted">{summary}</p>
          <ul class="mt-6 grid gap-3 border-t border-border pt-5 text-sm leading-5">
            {points.map((point) => (
              <li class="before:mr-2 before:text-accent before:content-['→']">{point}</li>
            ))}
          </ul>
        </article>
        {index < stages.length - 1 && (
          <ArrowDown
            class="mx-auto size-5 text-muted lg:hidden"
            aria-hidden="true"
          />
        )}
      </div>
    ))
  }
</div>
<p class="mt-6 text-center font-mono text-xs font-bold tracking-wider text-muted uppercase">
  Review informs the next plan or the next authorized milestone.
</p>
