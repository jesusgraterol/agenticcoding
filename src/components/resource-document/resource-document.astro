---
import { Download } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import CopyButton from 'jg-personal-astro-ui/copy-button';
import FilePreview from 'jg-personal-astro-ui/file-preview';

interface Props {
  // what the copy button copies, completing its name, as in "Copy AGENTS.md"
  copyContext: string;
  fileName: string;
  rawPath: string;
  sourceId: string;
  text: string;
  allowDownload?: boolean;
}

const { allowDownload = false, copyContext, fileName, rawPath, sourceId, text } = Astro.props;
---

{/* the resource as published: its file name, copying and the raw file, then its full text */}
<FilePreview path={fileName}>
  <div
    slot="header-actions"
    class="flex flex-wrap items-center gap-2"
  >
    <CopyButton
      display="icon"
      context={copyContext}
      size="md"
      tone="outline"
      url={rawPath}
    />
    {
      allowDownload && (
        <Button
          download={fileName}
          href={rawPath}
          variant="outline"
        >
          <Download
            class="size-4"
            aria-hidden="true"
          />
          Download
        </Button>
      )
    }
    <Button
      external
      href={rawPath}
      variant="outline"
    >
      View raw
    </Button>
  </div>
  {/* literal text retains the canonical final newline that syntax highlighting removes */}
  <pre
    id={sourceId}
    aria-label={fileName + ' source'}
    role="region"
    class="max-h-[70vh] overflow-auto font-mono text-sm leading-6 wrap-anywhere whitespace-pre-wrap text-foreground"
    tabindex="0"><code>{text}</code></pre>
</FilePreview>
