---
const codingAgents = [
  { company: 'OpenAI', height: 300, name: 'Codex', path: '/coding-agents/codex.svg', width: 300 },
  {
    company: 'Anthropic',
    height: 248,
    name: 'Claude Code',
    path: '/coding-agents/claude-code.svg',
    width: 248,
  },
  {
    company: 'Anysphere',
    height: 532,
    name: 'Cursor',
    path: '/coding-agents/cursor.svg',
    width: 467,
  },
  {
    company: 'Anomaly',
    height: 300,
    name: 'OpenCode',
    path: '/coding-agents/opencode.svg',
    width: 300,
  },
  {
    company: 'GitHub',
    height: 96,
    name: 'GitHub Copilot',
    path: '/coding-agents/github-copilot.svg',
    width: 96,
  },
  { company: 'Cline', height: 96, name: 'Cline', path: '/coding-agents/cline.svg', width: 92 },
] as const;
---

<section
  class="border-y border-border py-14 sm:py-16"
  aria-labelledby="coding-agent-strip-title"
>
  <div class="page-shell">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <p class="eyebrow">Host-agnostic</p>
      <h2
        id="coding-agent-strip-title"
        class="mt-3 text-2xl font-semibold tracking-tight"
      >
        Use the coding agent already in your repository.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-muted">
        The prompt is portable. The engineering values matter more than the host.
      </p>
    </div>
    <ul
      class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        codingAgents.map(({ company, height, name, path, width }) => (
          <li class="flex min-w-0 flex-col items-center justify-center bg-background px-2 py-4 text-center">
            <img
              class:list={[
                'size-9 object-contain',
                name !== 'Claude Code' && name !== 'OpenCode' && 'dark:invert',
              ]}
              src={path}
              width={width}
              height={height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="mt-3 text-sm font-semibold">{name}</span>
            <span class="sr-only"> by {company}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
