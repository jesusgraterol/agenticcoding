---
import { ArrowUpRight } from '@lucide/astro';

import { SITE_CONFIG } from '../../site.config.ts';

// what moldea demonstrates, following its own product foundation; no hosted-platform claims
const evidenceItems = [
  {
    description:
      'Purpose, constraints, rules, and decisions live beside the code and go through ordinary review.',
    title: 'Project knowledge in Git',
  },
  {
    description:
      'The open-source Agent Skill loads what the task needs and leaves planning, implementation, review, and publication to your agent and workflow.',
    title: 'Only relevant context',
  },
  {
    description:
      'Packages check repository state without model calls, network access, or writes, leaving model judgment for real alignment questions.',
    title: 'Deterministic checks',
  },
] as const;
---

<div
  class="mt-12 overflow-hidden rounded-xl border border-border bg-surface lg:grid lg:grid-cols-2"
>
  <div class="flex flex-col border-b border-border p-6 sm:p-8 lg:border-r lg:border-b-0">
    <div class="flex items-center justify-between gap-4 font-mono text-xs text-muted">
      <span>field-application/01</span>
      <span>skill.moldea.ai</span>
    </div>
    <div class="flex flex-1 flex-col justify-center py-12 sm:py-16">
      <img
        class="h-auto w-52 max-w-full dark:hidden"
        src="/moldea/logo-light.png"
        width="942"
        height="210"
        loading="lazy"
        decoding="async"
        alt=""
        data-moldea-logo="light"
      />
      <img
        class="hidden h-auto w-52 max-w-full dark:block"
        src="/moldea/logo-dark.png"
        width="942"
        height="210"
        loading="lazy"
        decoding="async"
        alt=""
        data-moldea-logo="dark"
      />
      <p class="mt-8 max-w-md text-lg leading-7 font-semibold">
        Git-native project context for coding agents.
      </p>
      <p class="mt-2 max-w-md text-base leading-7 text-muted">
        Keep project knowledge in Git. Bring relevant context into coding-agent work.
      </p>
    </div>
    <a
      class="inline-flex w-fit items-center gap-2 text-sm font-semibold underline-offset-4 hover:underline"
      href={SITE_CONFIG.moldeaUrl}
      target="_blank"
      rel="noreferrer"
    >
      Explore the moldea Agent Skill
      <span class="sr-only"> (opens in a new tab)</span>
      <ArrowUpRight
        class="size-4"
        aria-hidden="true"
      />
    </a>
  </div>
  <ol class="grid gap-px bg-border">
    {
      evidenceItems.map(({ description, title }, index) => (
        <li class="bg-background p-6 sm:p-8">
          <div class="flex items-start gap-5">
            <span class="font-mono text-xs font-bold text-accent">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{description}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>
