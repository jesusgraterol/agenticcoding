---
import { ArrowUpRight } from '@lucide/astro';

import { SITE_CONFIG } from '../../site.config.ts';

/*
 * The parts of the moldea project, following its own product foundation. Only live destinations
 * are linked, and the hosted platform is described without availability claims.
 */
const projectParts = [
  {
    href: SITE_CONFIG.moldea.skillUrl,
    linkLabel: 'Agent Skill documentation',
    status: 'Open source',
    text: 'Creates and maintains project context in Git and brings only the relevant parts into coding-agent work. Planning, implementation, review, and publication stay with your agent and workflow.',
    title: 'Agent Skill',
  },
  {
    href: SITE_CONFIG.moldea.packagesUrl,
    linkLabel: 'Packages documentation',
    status: 'Open source',
    text: 'A CLI and TypeScript packages check context, decision records, and declared connections to code without model calls, network access, or writes.',
    title: 'Packages',
  },
  {
    href: undefined,
    linkLabel: undefined,
    status: 'In development',
    text: 'Visualization, collaboration, and pull-request Assurance through a GitHub integration, with the repository kept as the source of truth.',
    title: 'Hosted platform',
  },
] as const;
---

<div
  class="mt-12 overflow-hidden rounded-xl border border-border bg-surface lg:grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
>
  <div class="flex flex-col border-b border-border p-6 sm:p-8 lg:border-r lg:border-b-0">
    <div class="flex items-center justify-between gap-4 font-mono text-xs text-muted">
      <span>field-application/01</span>
      <span>moldea.ai</span>
    </div>
    <div class="flex flex-1 flex-col justify-center py-10 sm:py-14">
      <img
        class="h-auto w-52 max-w-full dark:hidden"
        src="/moldea/logo-light.png"
        width="942"
        height="210"
        loading="lazy"
        decoding="async"
        alt="moldea"
        data-moldea-logo="light"
      />
      <img
        class="hidden h-auto w-52 max-w-full dark:block"
        src="/moldea/logo-dark.png"
        width="942"
        height="210"
        loading="lazy"
        decoding="async"
        alt="moldea"
        data-moldea-logo="dark"
      />
      <p class="mt-8 max-w-md text-lg leading-7 font-semibold">
        Git-native project context for coding agents.
      </p>
      <p class="mt-2 max-w-md text-base leading-7 text-muted">
        Keep project knowledge in Git. Bring relevant context into coding-agent work.
      </p>
      <p class="mt-6 max-w-md border-l-2 border-accent pl-3 text-sm leading-6 text-muted">
        Purpose, constraints, rules, decisions, and agent instructions live under{' '}
        <code class="text-foreground">/moldea/</code> in the repository and go through ordinary review.
      </p>
    </div>
    <a
      class="inline-flex w-fit items-center gap-2 text-sm font-semibold underline-offset-4 hover:underline"
      href={SITE_CONFIG.moldea.githubUrl}
      target="_blank"
      rel="noreferrer"
    >
      moldea on GitHub
      <span class="sr-only"> (opens in a new tab)</span>
      <ArrowUpRight
        class="size-4"
        aria-hidden="true"
      />
    </a>
  </div>
  <ol class="grid gap-px bg-border">
    {
      projectParts.map(({ href, linkLabel, status, text, title }, index) => (
        <li class="bg-background p-6 sm:p-8">
          <div class="flex items-start gap-5">
            <span class="font-mono text-xs font-bold text-accent">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
                <span class="rounded-full border border-border-strong px-2 py-0.5 text-xs font-semibold text-muted">
                  {status}
                </span>
              </div>
              <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
              {href && (
                <a
                  class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline"
                  href={href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {linkLabel}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <ArrowUpRight
                    class="size-4"
                    aria-hidden="true"
                  />
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>
