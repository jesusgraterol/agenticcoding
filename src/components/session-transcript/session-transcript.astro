---
import { Bot, UserRound } from '@lucide/astro';
import Conversation from 'jg-personal-astro-ui/conversation';
import ConversationMessage from 'jg-personal-astro-ui/conversation-message';
import InlineCode from 'jg-personal-astro-ui/inline-code';

import type { ITranscriptMessage } from '../../content/index.ts';
import ArtifactPanel from '../artifact-panel/artifact-panel.astro';

interface Props {
  label: string;
  messages: readonly ITranscriptMessage[];
}

// visible speaker labels; examples stay free of coding-agent branding
const SPEAKER_LABELS = {
  agent: 'Coding agent',
  developer: 'You',
} as const satisfies Record<ITranscriptMessage['speaker'], string>;

const { label, messages } = Astro.props;
---

<Conversation label={label}>
  {
    messages.map(({ artifact, invocation, speaker, text }) => (
      <ConversationMessage speaker={SPEAKER_LABELS[speaker]}>
        <span
          slot="avatar"
          class:list={[
            'inline-flex size-8 items-center justify-center rounded-lg',
            speaker === 'developer'
              ? 'bg-primary text-primary-foreground'
              : 'border border-border bg-secondary text-accent',
          ]}
        >
          {speaker === 'developer' ? <UserRound class="size-4" /> : <Bot class="size-4" />}
        </span>
        {(invocation !== undefined || text !== undefined) && (
          <p class="text-sm leading-6">
            {invocation && (
              <InlineCode
                code={invocation}
                class="font-semibold"
              />
            )}
            {invocation && text && ' '}
            {text}
          </p>
        )}
        {artifact && (
          <ArtifactPanel
            slot="artifact"
            artifact={artifact}
          />
        )}
      </ConversationMessage>
    ))
  }
</Conversation>
