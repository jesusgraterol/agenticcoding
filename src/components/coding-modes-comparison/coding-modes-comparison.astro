---
const comparisonRows = [
  {
    category: 'Planning',
    manual: 'Developer-led and developer-executed',
    agentic: 'Developer and agent investigate together',
    vibe: 'Often compressed into the initial request',
  },
  {
    category: 'Architecture',
    manual: 'Designed directly by the developer',
    agentic: 'Proposed, challenged, and approved collaboratively',
    vibe: 'Frequently delegated with the implementation',
  },
  {
    category: 'Implementation',
    manual: 'Mostly written by the developer',
    agentic: 'Broadly delegable within approved boundaries',
    vibe: 'Broadly delegated toward a visible result',
  },
  {
    category: 'Context',
    manual: 'Held and explored by the developer',
    agentic: 'Inspected widely enough to understand the affected path',
    vibe: 'Often limited to the prompt and immediate files',
  },
  {
    category: 'Verification',
    manual: 'Developer runs and interprets checks',
    agentic: 'Agent operates most checks; developer challenges the evidence',
    vibe: 'Visible behavior may be the primary signal',
  },
  {
    category: 'Review',
    manual: 'Developer reviews their own or others’ work',
    agentic: 'Agent reviews fully; developer audits by risk and decides',
    vibe: 'May stop when the result appears to work',
  },
  {
    category: 'Responsibility',
    manual: 'Developer',
    agentic: 'Developer',
    vibe: 'Still the developer, even when inspection is light',
  },
  {
    category: 'Primary goal',
    manual: 'Direct control through direct execution',
    agentic: 'More leverage without surrendering discipline',
    vibe: 'Reach a result with minimal process overhead',
  },
] as const;
---

<div class="mt-12 overflow-hidden rounded-xl border border-border bg-surface">
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 font-mono text-xs text-muted sm:px-6"
  >
    <span>operating-model.matrix</span>
    <span>control determines the mode</span>
  </div>
  <div
    class="overflow-x-auto overscroll-x-contain focus-visible:ring-2 focus-visible:ring-focus focus-visible:outline-none focus-visible:ring-inset"
    data-coding-mode-comparison-scroll
    role="region"
    aria-label="Coding mode comparison"
    tabindex="0"
  >
    <table class="w-full min-w-[44rem] table-fixed border-collapse text-left">
      <caption class="sr-only">
        How manual coding, Agentic Coding, and vibe coding differ across the engineering lifecycle.
      </caption>
      <colgroup>
        <col class="w-32" />
        <col />
        <col />
        <col />
      </colgroup>
      <thead class="border-b border-border bg-secondary/70 text-sm font-semibold">
        <tr>
          <th
            class="sticky left-0 z-20 border-r border-border bg-secondary p-4"
            scope="col"
          >
            Dimension
          </th>
          <th
            class="p-4"
            scope="col"
          >
            Manual coding
          </th>
          <th
            class="border-l border-border bg-accent/10 p-4 text-accent"
            scope="col"
          >
            Agentic Coding
          </th>
          <th
            class="border-l border-border p-4"
            scope="col"
          >
            Vibe coding
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {
          comparisonRows.map(({ agentic, category, manual, vibe }) => (
            <tr class="bg-background align-top">
              <th
                class="sticky left-0 z-10 border-r border-border bg-background p-4 text-sm font-semibold"
                scope="row"
              >
                {category}
              </th>
              <td class="p-4 text-sm leading-6 text-muted">{manual}</td>
              <td class="border-l border-border bg-accent/8 p-4 text-sm leading-6 font-semibold">
                {agentic}
              </td>
              <td class="border-l border-border p-4 text-sm leading-6 text-muted">{vibe}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
