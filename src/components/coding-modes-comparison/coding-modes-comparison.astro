---
import Table from 'jg-personal-astro-ui/table';

const comparisonRows = [
  {
    category: 'Planning',
    manual: 'Developer-led and developer-executed',
    agentic: 'Developer and agent investigate together',
    vibe: 'Often compressed into the initial request',
  },
  {
    category: 'Architecture',
    manual: 'Designed directly by the developer',
    agentic: 'Proposed, challenged, and approved collaboratively',
    vibe: 'Frequently delegated with the implementation',
  },
  {
    category: 'Implementation',
    manual: 'Mostly written by the developer',
    agentic: 'Broadly delegable within approved boundaries',
    vibe: 'Broadly delegated toward a visible result',
  },
  {
    category: 'Context',
    manual: 'Held and explored by the developer',
    agentic: 'Inspected widely enough to understand the affected path',
    vibe: 'Often limited to the prompt and immediate files',
  },
  {
    category: 'Verification',
    manual: 'Developer runs and interprets checks',
    agentic: 'Agent operates most checks; developer challenges the evidence',
    vibe: 'Visible behavior may be the primary signal',
  },
  {
    category: 'Review',
    manual: 'Developer reviews their own or others’ work',
    agentic: 'Agent reviews fully; developer audits by risk and decides',
    vibe: 'May stop when the result appears to work',
  },
  {
    category: 'Publication',
    manual: 'Developer performs the external action directly',
    agentic: 'Explicitly granted, per change or per autonomous run',
    vibe: 'May follow automatically from apparent completion',
  },
  {
    category: 'Responsibility',
    manual: 'Developer',
    agentic: 'Developer',
    vibe: 'Still the developer, even when inspection is light',
  },
  {
    category: 'Primary goal',
    manual: 'Direct control through direct execution',
    agentic: 'More leverage without surrendering discipline',
    vibe: 'Reach a result with minimal process overhead',
  },
] as const;
---

<div class="mt-12 grid gap-3">
  <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-muted">
    <span>operating-model.matrix</span>
    <span>control determines the mode</span>
  </div>
  {/* wider than a phone, so it scrolls on its own, with the dimension column pinned */}
  <Table
    caption="How manual coding, Agentic Coding, and vibe coding differ across the engineering lifecycle."
    captionHidden
    class="overscroll-x-contain [&_table]:min-w-[44rem] [&_table]:table-fixed [&_tbody_th]:whitespace-normal"
    scrollLabel="Coding mode comparison"
    stickyFirstColumn
  >
    <colgroup>
      <col class="w-32" />
      <col />
      <col />
      <col />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">Dimension</th>
        <th scope="col">Manual coding</th>
        <th
          class="border-l border-border bg-accent/10"
          scope="col"
        >
          Agentic Coding
        </th>
        <th
          class="border-l border-border"
          scope="col"
        >
          Vibe coding
        </th>
      </tr>
    </thead>
    <tbody>
      {
        comparisonRows.map(({ agentic, category, manual, vibe }) => (
          <tr>
            <th scope="row">{category}</th>
            <td class="leading-6 text-muted">{manual}</td>
            <td class="border-l border-border bg-accent/8 leading-6 font-semibold">{agentic}</td>
            <td class="border-l border-border leading-6 text-muted">{vibe}</td>
          </tr>
        ))
      }
    </tbody>
  </Table>
</div>
