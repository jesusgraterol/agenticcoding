---
import { Eye, PencilLine } from '@lucide/astro';

const paths = [
  { depth: 0, mode: 'inspect', path: 'src/' },
  { depth: 1, mode: 'inspect', path: 'auth/' },
  { depth: 2, mode: 'inspect', path: 'session.service.ts' },
  { depth: 2, mode: 'inspect', path: 'permissions.ts' },
  { depth: 1, mode: 'edit', path: 'api-keys/' },
  { depth: 2, mode: 'edit', path: 'api-keys.service.ts' },
  { depth: 2, mode: 'edit', path: 'api-keys.service.test-integration.ts' },
  { depth: 1, mode: 'inspect', path: 'organizations/' },
  { depth: 2, mode: 'inspect', path: 'organization.model.ts' },
  { depth: 1, mode: 'inspect', path: 'shared/crypto/' },
] as const;
---

<div class="mt-12 grid overflow-hidden rounded-xl border border-border lg:grid-cols-[1fr_22rem]">
  <div class="bg-code p-5 font-mono text-sm sm:p-8">
    <div class="mb-5 flex flex-wrap gap-4 border-b border-border pb-4 text-xs font-bold">
      <span class="inline-flex items-center gap-2"
        ><Eye
          class="size-4"
          aria-hidden="true"
        /> Inspect to understand</span
      >
      <span class="inline-flex items-center gap-2 text-accent"
        ><PencilLine
          class="size-4"
          aria-hidden="true"
        /> Authorized to edit</span
      >
    </div>
    <ul
      class="grid gap-1.5"
      aria-label="Example repository paths and authority"
    >
      {
        paths.map(({ depth, mode, path }) => (
          <li
            class:list={[
              'flex min-w-0 items-center gap-2 rounded px-2 py-1.5',
              mode === 'edit' && 'bg-accent/12 font-bold text-accent dark:bg-primary/50',
            ]}
            style={`padding-left: ${depth * 1.25 + 0.5}rem`}
          >
            {mode === 'edit' ? (
              <PencilLine
                class="size-3.5 shrink-0"
                aria-hidden="true"
              />
            ) : (
              <Eye
                class="size-3.5 shrink-0 text-muted"
                aria-hidden="true"
              />
            )}
            <span class="truncate">{path}</span>
            <span class="sr-only">— {mode === 'edit' ? 'authorized to edit' : 'inspect only'}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <aside class="bg-surface p-6 sm:p-8">
    <p class="eyebrow">Requested task</p>
    <p class="mt-3 text-xl leading-8 font-bold">Add organization-owned API-key rotation.</p>
    <div class="mt-8 border-t border-border pt-6">
      <p class="text-sm leading-6 text-muted">
        Authentication, organization ownership, and cryptography are dependencies worth
        understanding. Only the API-key path is a deliverable.
      </p>
    </div>
  </aside>
</div>
